+	const race = safeName(params.race);
+	const outfit = safeName(params.outfit.endsWith('.png') ? params.outfit.slice(0, -4) : params.outfit);
+	const file = set && race && outfit ? finishedPath(set, race, outfit) : null;
+	if (!file) error(404, 'No such plate.');
+	let bytes: Buffer;
+	try {
+		bytes = await fs.readFile(file);
+	} catch {
+		error(404, 'No such plate.');
+	}
+	return new Response(new Uint8Array(bytes), {
+		headers: { 'content-type': 'image/png', 'cache-control': 'no-store' }
+	});
+};
