@@ -0,0 +1,71 @@
+/**
+ * Which image models a picture job uses, and in what order: one setting per job type, so the models change without a
+ * code change (on Vercel: change the value, then Redeploy). The first model is the first choice and the rest are its
+ * backups, in order. With no setting the lists are the ones the code had before.
+ *
+ * Each job keeps the list it started with (a costume row, a race outfit ticket), so a changed setting only reaches
+ * new jobs. A wrong setting stops a job from starting and says which id is wrong; the default is never used in its
+ * place without saying so. `clothesImageModels` is the one place a clothes job gets its list, so Model Manager can
+ * supply it later.
+ */
+import { AuthoringError } from '../authoring/authoringHttp';
+import { getGptImage25Model, STUDIO_CLOTHES_I2I_MODELS } from './gptImageRegistry';
+import { HUGGINGFACE_IDENTITY_EDIT_MODEL_ID, HUGGINGFACE_PROVIDER_ID } from './registry';
+
+/** Krea 2 identity edit on Charles's Hugging Face Space: the last backup, and the one model that is not GPT Image. */
+export const STUDIO_CLOTHES_KREA_MODEL_ID = `${HUGGINGFACE_PROVIDER_ID}/${HUGGINGFACE_IDENTITY_EDIT_MODEL_ID}`;
+
+/** Studio clothes and costumes, and avatar-set race outfits: a comma-separated list of model ids. */
+export const CLOTHES_MODELS_SETTING = 'IMAGE_MODELS_CLOTHES';
+
+/** The clothes list when the setting is not set: the GPT Image models in their order, then Krea 2. */
+export const DEFAULT_CLOTHES_MODELS: readonly string[] = [
+	...STUDIO_CLOTHES_I2I_MODELS.map((model) => model.id),
+	STUDIO_CLOTHES_KREA_MODEL_ID
+];
+
+const logged = new Set<string>();
+
+/** The clothes models for a job that is starting now. Throws, and logs why, when the setting is wrong. */
+export function clothesImageModels(env: Record<string, string | undefined> = process.env): readonly string[] {
+	const raw = env[CLOTHES_MODELS_SETTING]?.trim();
+	const models = raw
+		? raw
+				.split(',')
+				.map((id) => id.trim())
+				.filter(Boolean)
+		: DEFAULT_CLOTHES_MODELS;
+	const problem = raw ? clothesModelsProblem(models) : null;
+	if (problem) {
+		console.error('image models setting is wrong', { setting: CLOTHES_MODELS_SETTING, value: raw, ...problem });
+		throw new AuthoringError(
+			503,
+			'IMAGE_MODELS_SETTING_INVALID',
+			`New pictures cannot be made: the ${CLOTHES_MODELS_SETTING} setting is wrong (${problem.why}).`
+		);
+	}
+	const key = models.join(',');
+	if (!logged.has(key)) {
+		logged.add(key);
+		console.info('image models', { job: 'clothes', setting: CLOTHES_MODELS_SETTING, from: raw ? 'setting' : 'default', models });
+	}
+	return models;
+}
+
+function clothesModelsProblem(models: readonly string[]): { readonly id?: string; readonly why: string } | null {
+	if (models.length === 0) return { why: 'it lists no model' };
+	for (const [at, id] of models.entries()) {
+		if (models.indexOf(id) !== at) return { id, why: `"${id}" is listed twice` };
+		if (id === STUDIO_CLOTHES_KREA_MODEL_ID) {
+			// The try rule uses Krea 2 once the GPT Image models are busy or down, so it has no place before them.
+			if (at !== models.length - 1) return { id, why: `Krea 2 ("${id}") can only be the last model in the list` };
+			continue;
+		}
+		const model = getGptImage25Model(id);
+		if (!model) return { id, why: `"${id}" is not an image model this server knows` };
+		if (model.modality !== 'image-to-image') {
+			return { id, why: `"${id}" makes pictures from words only, and clothes need a model that edits a picture` };
+		}
+	}
+	return null;
+}
