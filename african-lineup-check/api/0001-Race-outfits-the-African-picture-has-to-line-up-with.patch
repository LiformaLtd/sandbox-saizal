+import sharp from 'sharp';
+import { describe, expect, it } from 'vitest';
+
+import { checkPlateLineUp, lineUpPixels } from './plateLineUp';
+
+const SIZE = 1024;
+const SHIRT = [120, 120, 120];
+const BLACK_TOP = [15, 15, 15];
+const LIGHT_SKIN = [220, 170, 140];
+const DARK_SKIN = [90, 60, 45];
+
+type Box = readonly [left: number, top: number, right: number, bottom: number];
+
+/** A see-through 1024 picture with solid boxes painted in order (right and bottom are not included). */
+function picture(...boxes: readonly (readonly [Box, readonly number[] | null])[]): Buffer {
+	const rgba = Buffer.alloc(SIZE * SIZE * 4);
+	for (const [[left, top, right, bottom], colour] of boxes) {
+		for (let y = top; y < bottom; y += 1) {
+			for (let x = left; x < right; x += 1) rgba.set(colour ? [...colour, 255] : [0, 0, 0, 0], (y * SIZE + x) * 4);
+		}
+	}
+	return rgba;
+}
+
+const BODY: Box = [300, 300, 700, SIZE];
+const HAND: Box = [320, 700, 380, 760];
+const HAND_LOWER: Box = [320, 730, 380, 790];
+
+describe('plate line-up check', () => {
+	it('passes the same picture twice', () => {
+		const plate = picture([BODY, SHIRT], [HAND, LIGHT_SKIN]);
+		expect(checkPlateLineUp(plate, plate, 'female')).toEqual({
+			movedPx: 0,
+			movedAt: null,
+			uncoveredPx: 0,
+			uncoveredAt: null,
+			widerPx: 0,
+			widerAt: null,
+			pass: true
+		});
+	});
+
+	it('passes darker skin, and dark shading, where the European picture has skin', () => {
+		const european = picture([BODY, SHIRT], [HAND, LIGHT_SKIN]);
+		expect(checkPlateLineUp(european, picture([BODY, SHIRT], [HAND, DARK_SKIN]), 'female').movedPx).toBe(0);
+		expect(checkPlateLineUp(european, picture([BODY, SHIRT], [HAND, [30, 25, 22]]), 'female').movedPx).toBe(0);
+	});
+
+	it('fails a hand that moved 30 px over the clothes, and says where', () => {
+		const report = checkPlateLineUp(
+			picture([BODY, SHIRT], [HAND, LIGHT_SKIN]),
+			picture([BODY, SHIRT], [HAND_LOWER, DARK_SKIN]),
+			'female'
+		);
+		expect(report).toMatchObject({ movedPx: 30, pass: false });
+		expect(report.movedAt).toEqual([320, 700, 379, 729]);
+	});
+
+	it('still catches a hand that moved over a black top', () => {
+		const report = checkPlateLineUp(
+			picture([BODY, BLACK_TOP], [HAND, LIGHT_SKIN]),
+			picture([BODY, BLACK_TOP], [HAND_LOWER, DARK_SKIN]),
+			'female'
+		);
+		// Where the hand left, the black top reads as shade and is excused; where it arrived, it is caught.
+		expect(report).toMatchObject({ movedPx: 30, movedAt: [320, 760, 379, 789], pass: false });
+	});
+
+	it('passes a move of 10 px', () => {
+		const report = checkPlateLineUp(
+			picture([BODY, SHIRT], [HAND, LIGHT_SKIN]),
+			picture([BODY, SHIRT], [[320, 710, 380, 770], DARK_SKIN]),
+			'female'
+		);
+		expect(report).toMatchObject({ movedPx: 10, pass: true });
+	});
+
+	it('only reports a body that came out narrower or wider', () => {
+		const european = picture([BODY, SHIRT]);
+		expect(checkPlateLineUp(european, picture([[320, 300, 700, SIZE], SHIRT]), 'female')).toMatchObject({
+			movedPx: 0,
+			uncoveredPx: 20,
+			widerPx: 0,
+			pass: true
+		});
+		expect(checkPlateLineUp(european, picture([[280, 300, 700, SIZE], SHIRT]), 'female')).toMatchObject({
+			movedPx: 0,
+			uncoveredPx: 0,
+			widerPx: 20,
+			pass: true
+		});
+	});
+
+	it('ignores specks and pinholes', () => {
+		const european = picture([BODY, SHIRT]);
+		const african = picture([BODY, SHIRT], [[400, 600, 410, 610], null], [[100, 600, 110, 610], SHIRT]);
+		expect(checkPlateLineUp(european, african, 'female')).toMatchObject({ uncoveredPx: 0, widerPx: 0, pass: true });
+	});
+
+	it('does not look above the base of the neck: row 434 for women, 414 for men', () => {
+		const european = picture([BODY, SHIRT]);
+		const african = picture([BODY, SHIRT], [[400, 414, 460, 434], DARK_SKIN]);
+		expect(checkPlateLineUp(european, african, 'female').movedPx).toBe(0);
+		expect(checkPlateLineUp(european, african, 'male').movedPx).toBe(20);
+	});
+
+	it('reads a picture and its cut-out as they are, and refuses another size', async () => {
+		const rgb = await sharp({ create: { width: SIZE, height: SIZE, channels: 4, background: { r: 9, g: 8, b: 7, alpha: 0 } } })
+			.png()
+			.toBuffer();
+		const alpha = await sharp({ create: { width: SIZE, height: SIZE, channels: 3, background: { r: 200, g: 200, b: 200 } } })
+			.png()
+			.toBuffer();
+		const pixels = await lineUpPixels(rgb, alpha);
+		expect(pixels).toHaveLength(SIZE * SIZE * 4);
+		expect([...pixels.subarray(0, 4)]).toEqual([9, 8, 7, 200]);
+		const small = await sharp(alpha).resize(512, 512).png().toBuffer();
+		await expect(lineUpPixels(small, small)).rejects.toThrow('The line-up check needs 1024x1024 pictures, got 512x512.');
+	});
+});
