@@ -0,0 +1,88 @@
+import { describe, expect, it } from 'vitest';
+
+import { collarAtSize, keepAtSize, stackHeadNeckPlate, type OutfitCollar } from './headNeckPlate';
+
+const SIZE = 256;
+const N = SIZE * SIZE;
+
+function fill(rgba: number[], alpha = 255): Uint8ClampedArray {
+	const out = new Uint8ClampedArray(N * 4);
+	for (let i = 0; i < N; i++) out.set([...rgba, alpha], i * 4);
+	return out;
+}
+
+function at(rgba: ArrayLike<number>, x: number, y: number): number[] {
+	const k = (y * SIZE + x) * 4;
+	return [rgba[k], rgba[k + 1], rgba[k + 2], rgba[k + 3]];
+}
+
+function setPixel(rgba: Uint8ClampedArray, x: number, y: number, value: number[]): void {
+	rgba.set(value, (y * SIZE + x) * 4);
+}
+
+/** Head on rows < 100; the old head and the chin cut at row 120; the jaw zone rows 90-119; collar at row 150. */
+function scene() {
+	const light = fill([200, 150, 100]);
+	const dark = fill([100, 60, 30]);
+	const headNeck = new Uint8ClampedArray(N * 4);
+	const headShape = new Uint8ClampedArray(N * 4);
+	for (let y = 0; y < SIZE; y++) {
+		for (let x = 0; x < SIZE; x++) {
+			if (y < 100) setPixel(headNeck, x, y, [10, 20, 30, 255]);
+			const oldHead = y < 120 && x >= 64 && x < 192;
+			setPixel(headShape, x, y, [y >= 90 && y < 120 ? 255 : 0, y < 120 ? 255 : 0, oldHead ? 255 : 0, 255]);
+		}
+	}
+	const collar: OutfitCollar = { line: new Array(1024).fill(600), keep: [] };
+	return { light, dark, headNeck, headShape, collar };
+}
+
+const MIX: [number, number, number] = [0.5, 0.5, 0.5];
+
+describe('stackHeadNeckPlate', () => {
+	it('lays the head on the mixed outfit and clears the old head round it', () => {
+		const s = scene();
+		const out = stackHeadNeckPlate(s.light, s.dark, s.headNeck, s.headShape, s.collar, MIX, SIZE);
+		expect(at(out, 128, 50)).toEqual([10, 20, 30, 255]);
+		expect(at(out, 128, 110)[3]).toBe(0);
+		expect(at(out, 128, 200)).toEqual([150, 105, 65, 255]);
+	});
+
+	it('keeps the clothing the collar file lists by the jaw, in the light plate colour', () => {
+		const s = scene();
+		setPixel(s.light, 128, 110, [20, 40, 90, 255]);
+		const collar: OutfitCollar = { ...s.collar, keep: [[440, 512, 516]] };
+		const out = stackHeadNeckPlate(s.light, s.dark, s.headNeck, s.headShape, collar, MIX, SIZE);
+		expect(at(out, 128, 110)).toEqual([20, 40, 90, 255]);
+		expect(at(out, 129, 110)[3]).toBe(0);
+	});
+
+	it('drops what only the light plate wears high up', () => {
+		const s = scene();
+		setPixel(s.dark, 20, 50, [0, 0, 0, 0]);
+		const out = stackHeadNeckPlate(s.light, s.dark, new Uint8ClampedArray(N * 4), s.headShape, s.collar, MIX, SIZE);
+		expect(at(out, 20, 50)[3]).toBe(0);
+		expect(at(out, 20, 60)).toEqual([150, 105, 65, 255]);
+	});
+
+	it('stops the neck at the outfit collar line', () => {
+		const s = scene();
+		for (let y = 100; y < SIZE; y++) for (let x = 0; x < SIZE; x++) setPixel(s.headNeck, x, y, [10, 20, 30, 255]);
+		const out = stackHeadNeckPlate(s.light, s.dark, s.headNeck, s.headShape, s.collar, MIX, SIZE);
+		expect(at(out, 128, 140)).toEqual([10, 20, 30, 255]);
+		expect(at(out, 128, 160)).toEqual([150, 105, 65, 255]);
+		expect(collarAtSize(s.collar.line, SIZE)[128]).toBe(150);
+	});
+
+	it('scales the kept clothing to the plate size', () => {
+		const mask = keepAtSize([[440, 512, 520]], SIZE);
+		expect(mask[110 * SIZE + 128]).toBe(1);
+		expect(mask[110 * SIZE + 129]).toBe(1);
+		expect(mask[110 * SIZE + 130]).toBe(0);
+	});
+
+	it('needs every input at the plate size', () => {
+		const s = scene();
+		expect(() => stackHeadNeckPlate(s.light, s.dark, new Uint8ClampedArray(4), s.headShape, s.collar, MIX, SIZE)).toThrow();
+	});
+});
