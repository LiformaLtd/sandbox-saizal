+++ b/packages/public-experience-chooser/src/suggestionPrompt.ts
@@ -78,3 +78,21 @@ export function sectionsFromSuggestionBrief(brief: {
 	}
 	return parseGenerationPrompt(brief.generationPrompt ?? '');
 }
+
+/**
+ * Experience brief for one (possibly edited) suggestion card: title and description first, so the
+ * setup generator keeps them, then the four sections.
+ */
+export function composeSuggestionBrief(input: {
+	readonly title: string;
+	readonly description: string;
+	readonly sections: SuggestionPromptSections;
+}): string {
+	return [
+		`Title:\n${input.title.trim()}`,
+		input.description.trim() ? `Description:\n${input.description.trim()}` : '',
+		composeGenerationPrompt(input.sections)
+	]
+		.filter(Boolean)
+		.join('\n\n');
+}
