@@ -0,0 +1,52 @@
+// LOCAL ONLY (2026-10-28): a catalogue outfit's ethnicity plate, made on the API with the neck fit - the same bake a
+// character save runs - so the Studio preview shows the saved picture and the browser does no blending.
+// ?avatarSetId=&outfit=&race=&size=256|512|1024&format=webp|png
+import { error } from '@sveltejs/kit';
+import { isMakerInputName } from '$lib/avatarSetClothes/legacyOutfitInputUrl';
+import { liformaApiFetch } from '$lib/server/liformaApi';
+import { apiErrorResponse, requireStudioSession } from '$lib/server/studioBff';
+
+import type { RequestHandler } from './$types';
+
+const SET_ID = /^[0-9a-z]{8}$/;
+const SIZES = ['256', '512', '1024'];
+const FORMATS = ['webp', 'png'];
+
+export const GET: RequestHandler = async (event) => {
+	const session = await requireStudioSession(event);
+	const { url } = event;
+	const avatarSetId = url.searchParams.get('avatarSetId') ?? '';
+	const outfit = url.searchParams.get('outfit') ?? '';
+	const race = url.searchParams.get('race') ?? '';
+	const size = url.searchParams.get('size') ?? '1024';
+	const format = url.searchParams.get('format') ?? 'webp';
+	if (
+		!SET_ID.test(avatarSetId) ||
+		!outfit ||
+		!race ||
+		!isMakerInputName(outfit) ||
+		!isMakerInputName(race) ||
+		!SIZES.includes(size) ||
+		!FORMATS.includes(format)
+	) {
+		error(400, 'Bad plate request');
+	}
+	const query = new URLSearchParams({ outfit, race, size, format });
+	try {
+		const upstream = await liformaApiFetch(
+			session.user.id,
+			`/internal/avatar-sets/${avatarSetId}/fitted-plate?${query}`,
+			{ timeoutMs: 60_000 }
+		);
+		if (!upstream.ok) error(upstream.status === 404 ? 404 : 502, 'No such plate');
+		return new Response(await upstream.arrayBuffer(), {
+			headers: {
+				'content-type': upstream.headers.get('content-type') ?? 'application/octet-stream',
+				'cache-control': 'private, max-age=86400'
+			}
+		});
+	} catch (caught) {
+		if (caught && typeof caught === 'object' && 'status' in caught) throw caught;
+		return apiErrorResponse(caught);
+	}
+};
