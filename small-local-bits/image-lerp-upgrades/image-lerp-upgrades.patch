+// The finished race plates (face pasted by the sandbox maker) live in local folders, never in static/: they are
+// hundreds of megabytes and change whenever the maker is rerun. One folder per endpoint pair; the env vars override.
+import { promises as fs } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+const DESKTOP = path.join(os.homedir(), 'Desktop');
+export const FINISHED_DIRS: Readonly<Record<string, string>> = {
+	female: process.env.FINISHED_PLATES_DIR ?? path.join(DESKTOP, 'outfit_plates_female', 'female_race_plates_mix'),
+	male: process.env.FINISHED_PLATES_DIR_MALE ?? path.join(DESKTOP, 'outfit_plates_male', 'male_race_plates_mix')
+};
+
