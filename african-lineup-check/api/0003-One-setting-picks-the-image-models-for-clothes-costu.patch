+		[
+			'azure/gpt-image-2.5-sunburst/low/text-to-image',
+			'"azure/gpt-image-2.5-sunburst/low/text-to-image" makes pictures from words only, and clothes need a model that edits a picture'
+		],
+		[`${AZURE},${AZURE}`, `"${AZURE}" is listed twice`],
+		[`${KREA},${AZURE}`, `Krea 2 ("${KREA}") can only be the last model in the list`],
+		[' , ', 'it lists no model']
