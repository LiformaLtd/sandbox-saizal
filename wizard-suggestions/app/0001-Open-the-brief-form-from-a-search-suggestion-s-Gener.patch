--- a/packages/experience-studio/src/lib/promptLimits.ts
+++ b/packages/experience-studio/src/lib/promptLimits.ts
@@ -32,3 +32,17 @@ export function maxlengthForAuthoringPath(path: string): number | undefined {
 	}
 	return undefined;
 }
+
+/**
+ * Fit text handed in from elsewhere (for example a search suggestion card) into a prompt limit:
+ * cut at the last sentence end before the limit, or at the last space when no sentence ends late enough.
+ */
+export function clampToPromptLimit(text: string, limit: number): string {
+	const trimmed = text.trim();
+	if (trimmed.length <= limit) return trimmed;
+	const head = trimmed.slice(0, limit);
+	const sentenceEnd = Math.max(head.lastIndexOf('. '), head.lastIndexOf('.\n'));
+	if (sentenceEnd >= limit * 0.6) return head.slice(0, sentenceEnd + 1);
+	const space = head.lastIndexOf(' ');
+	return (space > 0 ? head.slice(0, space) : head).trimEnd();
+}
