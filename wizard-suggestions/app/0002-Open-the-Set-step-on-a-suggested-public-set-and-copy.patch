+/** @vitest-environment happy-dom */
+import { describe, expect, it, vi } from 'vitest';
+import { flushSync, mount, unmount } from 'svelte';
+import SuggestedSetChoices from './SuggestedSetChoices.svelte';
+
+const set = (setId: string, name: string) => ({
+	setId,
+	name,
+	thumbnailUrl: null,
+	backgroundImage: null,
+	foregroundImage: null,
+	backdropId: `loc_${setId}`,
+	collection: 'modern',
+	venue: 'boutique_hotel',
+	setting: 'interior'
+});
+
+function render(props: { suggestions: ReturnType<typeof set>[]; currentSetId: string; disabled?: boolean }) {
+	const target = document.createElement('div');
+	document.body.append(target);
+	const onpick = vi.fn();
+	const component = mount(SuggestedSetChoices, { target, props: { ...props, onpick } });
+	flushSync();
+	return {
+		target,
+		onpick,
+		buttons: () => Array.from(target.querySelectorAll('button')),
+		cleanup: async () => {
+			await unmount(component);
+			target.remove();
+		}
+	};
+}
+
+describe('suggested set choices', () => {
+	it('says when the set is added and offers the other suggestions', async () => {
+		const lobby = set('set_lobby', 'Hotel · Lobby');
+		const lounge = set('set_lounge', 'Hotel · Lounge');
+		const view = render({ suggestions: [lobby, lounge], currentSetId: 'set_lobby' });
+		try {
+			expect(view.target.textContent).toContain('It is added to your project when you press Next.');
+			expect(view.buttons().map((button) => button.textContent?.trim())).toEqual(['Hotel · Lounge']);
+			view.buttons()[0]!.click();
+			expect(view.onpick).toHaveBeenCalledWith(lounge);
+		} finally {
+			await view.cleanup();
+		}
+	});
+
+	it('shows no other choices when there is one suggestion, and blocks them while busy', async () => {
+		const lobby = set('set_lobby', 'Hotel · Lobby');
+		const single = render({ suggestions: [lobby], currentSetId: 'set_lobby' });
+		const busy = render({ suggestions: [lobby, set('set_bar', 'Hotel · Bar')], currentSetId: 'set_lobby', disabled: true });
+		try {
+			expect(single.target.textContent).not.toContain('Or:');
+			expect(single.buttons()).toHaveLength(0);
+			expect(busy.buttons()[0]!.disabled).toBe(true);
+		} finally {
+			await single.cleanup();
+			await busy.cleanup();
+		}
+	});
+});
