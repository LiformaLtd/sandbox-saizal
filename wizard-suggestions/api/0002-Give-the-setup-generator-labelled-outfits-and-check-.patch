@@ -1,11 +1,121 @@
+import type { PrismaClient } from '@prisma/client';
+
 import { listPublishedAvatars } from '$lib/server/catalog/avatars';
-export type CharacterWardrobeChoices = Record<'female' | 'male', { clothes: string[]; hair: string[] }>;
+
+export const MAX_SUGGESTED_CLOTHES = 3;
+
+/** One published outfit as the setup generator reads it: the catalogue row's name and labels, when it has them. */
+export type ClothesChoice = {
+	readonly id: string;
+	readonly name: string;
+	readonly role: readonly string[];
+	readonly outfitType: readonly string[];
+	readonly formality: readonly string[];
+};
+export type CharacterWardrobeChoices = Record<'female' | 'male', { clothes: ClothesChoice[]; hair: string[] }>;
+
+const LABEL_DIMENSIONS = { role: 'role', 'outfit-type': 'outfitType', formality: 'formality' } as const;
+type LabelField = (typeof LABEL_DIMENSIONS)[keyof typeof LABEL_DIMENSIONS];
+
 /** Only published wardrobe ids are supplied to the initial experience generator. */
-export async function loadCharacterWardrobeChoices(): Promise<CharacterWardrobeChoices> {
+export async function loadCharacterWardrobeChoices(prisma: PrismaClient): Promise<CharacterWardrobeChoices> {
 	const avatars = await listPublishedAvatars();
 	const forGender = (gender: string) => {
 		const rows = avatars.filter(avatar => avatar.gender === gender && avatar.supportsCostumes);
 		return { clothes: [...new Set(rows.flatMap(row => row.clothesIds ?? []))], hair: [...new Set(rows.flatMap(row => row.hairIds ?? []))] };
 	};
-	return { female: forGender('female'), male: forGender('male') };
+	const female = forGender('female');
+	const male = forGender('male');
+	const described = await describeCatalogueClothes(prisma, [...female.clothes, ...male.clothes]);
+	const describe = (id: string): ClothesChoice => ({
+		id,
+		...(described.get(id.toLowerCase()) ?? { name: '', role: [], outfitType: [], formality: [] })
+	});
+	return {
+		female: { clothes: female.clothes.map(describe), hair: female.hair },
+		male: { clothes: male.clothes.map(describe), hair: male.hair }
+	};
+}
+
+/** Name and labels of the public catalogue rows for these outfit ids. Each avatar has its own row, so labels are merged. */
+async function describeCatalogueClothes(
+	prisma: PrismaClient,
+	ids: readonly string[]
+): Promise<Map<string, Omit<ClothesChoice, 'id'>>> {
+	const rows = await prisma.clothes.findMany({
+		where: {
+			visibility: 'public',
+			source: 'catalogue',
+			deletedAt: null,
+			catalogueKey: { in: [...new Set(ids.map(id => id.toLowerCase()))] }
+		},
+		select: {
+			catalogueKey: true,
+			name: true,
+			taxonomyAssignments: {
+				where: { dimension: { in: Object.keys(LABEL_DIMENSIONS) } },
+				select: { dimension: true, value: { select: { label: true } } }
+			}
+		}
+	});
+	const byKey = new Map<string, { name: string } & Record<LabelField, string[]>>();
+	for (const row of rows) {
+		const key = row.catalogueKey?.toLowerCase();
+		if (!key) continue;
+		const entry = byKey.get(key) ?? { name: '', role: [], outfitType: [], formality: [] };
+		if (!entry.name) entry.name = row.name.trim();
+		for (const { dimension, value } of row.taxonomyAssignments) {
+			const field = LABEL_DIMENSIONS[dimension as keyof typeof LABEL_DIMENSIONS];
+			if (field && !entry[field].includes(value.label)) entry[field].push(value.label);
+		}
+		byKey.set(key, entry);
+	}
+	return byKey;
+}
+
+/** e.g. `barista: Barista Apron Outfit (role: Barista; outfit: Uniform; formality: Casual)`. */
+export function clothesChoiceLine(choice: ClothesChoice): string {
+	const labels = [
+		choice.role.length > 0 ? `role: ${choice.role.join(', ')}` : '',
+		choice.outfitType.length > 0 ? `outfit: ${choice.outfitType.join(', ')}` : '',
+		choice.formality.length > 0 ? `formality: ${choice.formality.join(', ')}` : ''
+	].filter(Boolean);
+	const name = choice.name.trim();
+	return `${choice.id}${name ? `: ${name}` : ''}${labels.length > 0 ? ` (${labels.join('; ')})` : ''}`;
+}
+
+/** The wardrobe as the generator reads it: one line per outfit, bare hair ids. */
+export function wardrobePromptChoices(choices: CharacterWardrobeChoices) {
+	return {
+		female: { clothes: choices.female.clothes.map(clothesChoiceLine), hair: choices.female.hair },
+		male: { clothes: choices.male.clothes.map(clothesChoiceLine), hair: choices.male.hair }
+	};
+}
+
+/** Keeps only outfit ids in the chosen gender's published list; any other id is logged and dropped, never swapped. */
+export function checkedClothesPicks<
+	T extends {
+		readonly characterGender: string;
+		readonly characterClothesId: string;
+		readonly suggestedClothesIds: readonly string[];
+	}
+>(details: T, choices: CharacterWardrobeChoices | undefined): T {
+	const gender = details.characterGender;
+	const offered = new Set(
+		(gender === 'female' || gender === 'male' ? (choices?.[gender].clothes ?? []) : []).map(choice => choice.id)
+	);
+	const picked = [details.characterClothesId, ...details.suggestedClothesIds].map(id => id.trim()).filter(Boolean);
+	const unknown = picked.filter(id => !offered.has(id));
+	if (unknown.length > 0) {
+		console.warn('[experience.setup.details] outfit ids are not in the published list', {
+			gender,
+			unknown,
+			offered: offered.size
+		});
+	}
+	const characterClothesId = offered.has(details.characterClothesId.trim()) ? details.characterClothesId.trim() : '';
+	const suggestedClothesIds = [...new Set(details.suggestedClothesIds.map(id => id.trim()))]
+		.filter(id => offered.has(id) && id !== characterClothesId)
+		.slice(0, MAX_SUGGESTED_CLOTHES);
+	return { ...details, characterClothesId, suggestedClothesIds };
 }
