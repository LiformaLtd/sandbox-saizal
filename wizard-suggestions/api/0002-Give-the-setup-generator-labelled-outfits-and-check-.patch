+import type { PrismaClient } from '@prisma/client';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+vi.mock('$lib/server/catalog/avatars', () => ({
+	listPublishedAvatars: async () => [
+		{ id: 'anna', gender: 'female', supportsCostumes: true, clothesIds: ['barista', 'business_woman_in_suit.7'], hairIds: ['bob'] },
+		{ id: 'caleb', gender: 'male', supportsCostumes: true, clothesIds: ['barista', 'chef'], hairIds: ['crew'] },
+		{ id: 'sofia', gender: 'female', supportsCostumes: false, clothesIds: ['ballgown'], hairIds: [] }
+	]
+}));
+
+import {
+	checkedClothesPicks,
+	clothesChoiceLine,
+	loadCharacterWardrobeChoices,
+	type CharacterWardrobeChoices
+} from './characterWardrobeChoices';
+
+const label = (dimension: string, value: string) => ({ dimension, value: { label: value } });
+
+afterEach(() => {
+	vi.restoreAllMocks();
+});
+
+describe('loadCharacterWardrobeChoices', () => {
+	it('describes each published outfit with its catalogue name and merged labels', async () => {
+		const findMany = vi.fn(async () => [
+			{ catalogueKey: 'barista', name: 'Barista Apron Outfit', taxonomyAssignments: [label('role', 'Barista'), label('outfit-type', 'Uniform')] },
+			{ catalogueKey: 'barista', name: 'Barista Apron Outfit', taxonomyAssignments: [label('outfit-type', 'Uniform'), label('formality', 'Casual')] },
+			{ catalogueKey: 'chef', name: 'Chef Whites', taxonomyAssignments: [] }
+		]);
+		const choices = await loadCharacterWardrobeChoices({ clothes: { findMany } } as unknown as PrismaClient);
+
+		expect(findMany).toHaveBeenCalledWith(
+			expect.objectContaining({
+				where: {
+					visibility: 'public',
+					source: 'catalogue',
+					deletedAt: null,
+					catalogueKey: { in: ['barista', 'business_woman_in_suit.7', 'chef'] }
+				}
+			})
+		);
+		expect(choices.female).toEqual({
+			clothes: [
+				{ id: 'barista', name: 'Barista Apron Outfit', role: ['Barista'], outfitType: ['Uniform'], formality: ['Casual'] },
+				{ id: 'business_woman_in_suit.7', name: '', role: [], outfitType: [], formality: [] }
+			],
+			hair: ['bob']
+		});
+		expect(choices.male.clothes.map(clothesChoiceLine)).toEqual([
+			'barista: Barista Apron Outfit (role: Barista; outfit: Uniform; formality: Casual)',
+			'chef: Chef Whites'
+		]);
+	});
+});
+
+describe('checkedClothesPicks', () => {
+	const choices: CharacterWardrobeChoices = {
+		female: {
+			clothes: ['barista', 'waitress', 'chef'].map((id) => ({ id, name: '', role: [], outfitType: [], formality: [] })),
+			hair: []
+		},
+		male: { clothes: [], hair: [] }
+	};
+
+	it('keeps listed ids and drops a repeat of the starting outfit', () => {
+		const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+		expect(
+			checkedClothesPicks(
+				{ characterGender: 'female', characterClothesId: 'barista', suggestedClothesIds: ['waitress', 'barista', 'chef'] },
+				choices
+			)
+		).toEqual({ characterGender: 'female', characterClothesId: 'barista', suggestedClothesIds: ['waitress', 'chef'] });
+		expect(checkedClothesPicks({ characterGender: 'female', characterClothesId: '', suggestedClothesIds: [] }, choices))
+			.toEqual({ characterGender: 'female', characterClothesId: '', suggestedClothesIds: [] });
+		expect(warn).not.toHaveBeenCalled();
+	});
+
+	it('logs and drops ids that are not in the list for that gender', () => {
+		const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+		expect(
+			checkedClothesPicks(
+				{ characterGender: 'male', characterClothesId: 'barista', suggestedClothesIds: ['invented_coat'] },
+				choices
+			)
+		).toEqual({ characterGender: 'male', characterClothesId: '', suggestedClothesIds: [] });
+		expect(warn).toHaveBeenCalledWith('[experience.setup.details] outfit ids are not in the published list', {
+			gender: 'male',
+			unknown: ['barista', 'invented_coat'],
+			offered: 0
+		});
+	});
+});
diff --git a/src/lib/server/platform/characterWardrobeChoices.ts b/src/lib/server/platform/characterWardrobeChoices.ts
index 32e6665..03868ff 100644
--- a/src/lib/server/platform/characterWardrobeChoices.ts
