@@ -0,0 +1,82 @@
+/**
+ * Public sets offered to the experience setup generator, and the sets it suggests back.
+ * The model sees short numbered lines and returns numbers, so it never has to copy long ids.
+ */
+import type { PrismaClient } from '@prisma/client';
+
+import { listCatalogueSets, type CatalogueSetListItem } from '$lib/server/places/listCatalogueSets';
+
+export const MAX_SUGGESTED_SETS = 3;
+
+/** One public set, numbered for the model. */
+export type SetChoice = { readonly ref: number; readonly set: CatalogueSetListItem };
+
+/** What the Studio needs to show a suggested set and copy it into the project on Next. */
+export type SuggestedSet = Pick<
+	CatalogueSetListItem,
+	| 'setId'
+	| 'name'
+	| 'thumbnailUrl'
+	| 'backgroundImage'
+	| 'foregroundImage'
+	| 'backdropId'
+	| 'collection'
+	| 'venue'
+	| 'setting'
+>;
+
+export async function loadPublicSetChoices(prisma: PrismaClient): Promise<SetChoice[]> {
+	const { sets } = await listCatalogueSets(prisma, { library: 'public' });
+	return sets.map((set, index) => ({ ref: index + 1, set }));
+}
+
+/** Lines the model reads, e.g. `17: Boutique Hotel · Reception · Looking At Desk (modern)`. */
+export function setChoicePromptLines(choices: readonly SetChoice[]): string[] {
+	return choices.map(({ ref, set }) => `${ref}: ${set.name} (${set.collection.replace(/_/g, ' ')})`);
+}
+
+/** The model's numbers as sets, best first. Unknown and repeated numbers are dropped and logged. */
+export function suggestedSetsFromRefs(
+	refs: readonly number[],
+	choices: readonly SetChoice[]
+): SuggestedSet[] {
+	const byRef = new Map(choices.map((choice) => [choice.ref, choice.set]));
+	const suggested: SuggestedSet[] = [];
+	const unknown: number[] = [];
+	for (const ref of refs) {
+		const set = byRef.get(ref);
+		if (!set) {
+			unknown.push(ref);
+			continue;
+		}
+		if (suggested.some((row) => row.setId === set.setId)) continue;
+		suggested.push({
+			setId: set.setId,
+			name: set.name,
+			thumbnailUrl: set.thumbnailUrl,
+			backgroundImage: set.backgroundImage,
+			foregroundImage: set.foregroundImage,
+			backdropId: set.backdropId,
+			collection: set.collection,
+			venue: set.venue,
+			setting: set.setting
+		});
+		if (suggested.length === MAX_SUGGESTED_SETS) break;
+	}
+	if (unknown.length > 0) {
+		console.warn('[experience.setup.details] suggested set numbers are not in the list', {
+			unknown,
+			offered: choices.length
+		});
+	}
+	return suggested;
+}
+
+/** The generator's details as the Studio receives them: the set numbers swapped for the sets. */
+export function setupDetailsResponse<T extends { readonly suggestedSetRefs: readonly number[] }>(
+	details: T,
+	choices: readonly SetChoice[]
+): Omit<T, 'suggestedSetRefs'> & { readonly suggestedSets: SuggestedSet[] } {
+	const { suggestedSetRefs, ...rest } = details;
+	return { ...rest, suggestedSets: suggestedSetsFromRefs(suggestedSetRefs, choices) };
+}
