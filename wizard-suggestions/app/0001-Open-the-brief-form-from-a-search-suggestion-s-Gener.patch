@@ -0,0 +1,78 @@
+/** @vitest-environment happy-dom */
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { flushSync, mount, unmount } from 'svelte';
+
+import ExperienceSearchSuggestions from './ExperienceSearchSuggestions.svelte';
+import { composeSuggestionBrief } from './suggestionPrompt';
+import type { ExperienceSuggestionBrief } from './suggestionTypes';
+
+const brief: ExperienceSuggestionBrief = {
+	title: 'Calm a client',
+	useCaseRoot: 'training',
+	character: 'You are Maya, a hotel manager.',
+	playerRole: 'The user is a new receptionist.',
+	set: 'You are in a hotel lobby.',
+	situation: 'Maya is upset about a lost booking.',
+	generationPrompt: '',
+	description: 'You calm Maya down.'
+};
+
+const mounted: { component: ReturnType<typeof mount>; target: HTMLElement }[] = [];
+
+afterEach(async () => {
+	for (const { component, target } of mounted.splice(0)) {
+		await unmount(component);
+		target.remove();
+	}
+});
+
+async function renderCards(onGenerate?: (brief: string) => void) {
+	const target = document.createElement('div');
+	document.body.append(target);
+	const loadSuggestions = vi.fn(async () => ({ suggestions: [brief], nextCursor: null }));
+	const component = mount(ExperienceSearchSuggestions, {
+		target,
+		props: { query: 'calm a client', loadSuggestions, ...(onGenerate ? { onGenerate } : {}) }
+	});
+	mounted.push({ component, target });
+	await vi.waitFor(() => expect(target.querySelector('.card')).not.toBeNull());
+	flushSync();
+	const generate = () =>
+		Array.from(target.querySelectorAll('button')).find((button) => button.textContent?.trim() === 'Generate');
+	return { target, generate };
+}
+
+describe('search suggestion cards', () => {
+	it('hands the card brief, with the author edits, to the host on Generate', async () => {
+		const onGenerate = vi.fn();
+		const { target, generate } = await renderCards(onGenerate);
+
+		const description = target.querySelector<HTMLTextAreaElement>('textarea')!;
+		description.value = 'You calm Maya down before check-out.';
+		description.dispatchEvent(new Event('input', { bubbles: true }));
+		flushSync();
+		generate()!.click();
+
+		expect(onGenerate).toHaveBeenCalledTimes(1);
+		expect(onGenerate).toHaveBeenCalledWith(
+			composeSuggestionBrief({
+				title: 'Calm a client',
+				description: 'You calm Maya down before check-out.',
+				sections: {
+					character: brief.character,
+					playerRole: brief.playerRole,
+					set: brief.set,
+					situation: brief.situation
+				}
+			})
+		);
+		expect(target.textContent).not.toContain('coming soon');
+	});
+
+	it('shows no Generate button when the host cannot create experiences', async () => {
+		const { target, generate } = await renderCards();
+		expect(generate()).toBeUndefined();
+		expect(target.textContent).toContain('Here are three ideas.');
+		expect(target.textContent).not.toContain('click Generate');
+	});
+});
