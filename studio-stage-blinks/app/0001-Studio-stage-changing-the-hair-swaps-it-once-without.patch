 				libraryCostumes = rows;
 			});
 		},
-		madeHairUrl: (avatarId, hairId) => plateHair.imageFor(avatarId, hairId, 1024)
+		madeHairUrl: (avatarId, hairId) => plateHair.stageImageFor(avatarId, hairId)
 	});
 	/** Hair is only editable over a clothes layer, not a whole costume. */
 	const hairChangeEnabled = $derived(Boolean(resolvedClothes(editAppearance)));
@@ -890,7 +890,7 @@
 	 * this browser ('' while it is being made: the clothes alone). */
 	const previewScene = $derived.by(() => {
 		const layers = catalogueScene.avatarCompositePreview;
-		const made = layers ? plateHair.imageFor(editAvatarId, hairId, 1024) : null;
+		const made = layers ? plateHair.stageImageFor(editAvatarId, hairId, layers.hairUrl) : null;
 		return layers && made !== null
 			? { ...catalogueScene, avatarCompositePreview: { ...layers, hairUrl: made } }
 			: catalogueScene;
