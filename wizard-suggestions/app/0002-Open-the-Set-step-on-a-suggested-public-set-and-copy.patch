+<script lang="ts">
+	import type { SuggestedSetupSet } from '../../lib/client.js';
+	/** Shown under a suggested public set on the Set step: what Next does, and the other suggestions. */
+	let { suggestions, currentSetId, disabled = false, onpick }: {
+		suggestions: readonly SuggestedSetupSet[]; currentSetId: string; disabled?: boolean; onpick: (suggestion: SuggestedSetupSet) => void;
+	} = $props();
+	const others = $derived(suggestions.filter((row) => row.setId !== currentSetId));
+</script>
+<p class="note">Suggested for this experience. It is added to your project when you press Next.</p>
+{#if others.length > 0}
+	<div class="others" role="group" aria-label="Other suggested sets">
+		<span>Or:</span>
+		{#each others as other (other.setId)}
+			<button type="button" class="studio-btn secondary" {disabled} onclick={() => onpick(other)}>{other.name}</button>
+		{/each}
+	</div>
+{/if}
+<style>
+	.note { margin: 0.75rem 0 0; color: var(--text-muted, #667085); font-size: 0.875rem; }
+	.others { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 0.5rem; font-size: 0.875rem; }
+</style>
