@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import {
+  makeRacePlate,
+  PLATE_SIZE,
+  prepareFace,
+  type FaceOutline,
+} from "./ethnicityPlateMaker";
+
+const N = PLATE_SIZE * PLATE_SIZE;
+
+function plate(
+  paint: (x: number, y: number) => readonly [number, number, number, number],
+): Uint8Array {
+  const rgba = new Uint8Array(N * 4);
+  for (let y = 0; y < PLATE_SIZE; y++) {
+    for (let x = 0; x < PLATE_SIZE; x++)
+      rgba.set(paint(x, y), (y * PLATE_SIZE + x) * 4);
+  }
+  return rgba;
+}
+
+/** Chin line at row 352, across the neck. */
+function outline(): FaceOutline {
+  const dots478 = Array.from({ length: 478 }, (_, i) => [
+    300 + (i % 43) * 10,
+    352,
+  ]);
+  return { width: PLATE_SIZE, dots478 };
+}
+
+// The outfit's head and neck are 118 px across (cols 453-570), as Anna's are at the jaw. The face is 132 px
+// across (cols 446-577) down to row 360, as the African face is, and has the outfit's neck below.
+const inOutfit = (x: number) => x >= 453 && x <= 570;
+const inFace = (x: number, y: number) =>
+  y <= 360 ? x >= 446 && x <= 577 : inOutfit(x);
+
+describe("ethnicity plate jaw corners", () => {
+  it(
+    "keeps a face wider than the outfit outline where the outfit is empty",
+    { timeout: 60_000 },
+    () => {
+      // the outfit's outermost columns are a half see-through edge
+      const edge = (x: number) => (x === 453 || x === 570 ? 128 : 255);
+      const light = plate((x) =>
+        inOutfit(x) ? [210, 170, 140, edge(x)] : [0, 0, 0, 0],
+      );
+      const dark = plate((x) =>
+        inOutfit(x) ? [90, 50, 30, edge(x)] : [0, 0, 0, 0],
+      );
+      const face = prepareFace(
+        plate((x, y) => (inFace(x, y) ? [120, 70, 40, 255] : [0, 0, 0, 0])),
+        [outline(), outline(), outline()],
+      );
+      const { rgba, report } = makeRacePlate(light, dark, light, face, {
+        values: [1, 1, 1],
+      });
+      const at = (x: number, y: number) =>
+        Array.from(
+          rgba.subarray((y * PLATE_SIZE + x) * 4, (y * PLATE_SIZE + x) * 4 + 4),
+        );
+
+      // the jaw corners, in the rows where the face used to be trimmed to the outfit
+      for (const y of [350, 354, 358, 360]) {
+        expect(at(448, y), `left corner row ${y}`).toEqual([120, 70, 40, 255]);
+        expect(at(575, y), `right corner row ${y}`).toEqual([120, 70, 40, 255]);
+        expect(at(453, y), `outfit edge row ${y}`).toEqual([120, 70, 40, 255]);
+      }
+      // from the outline switch down, the outfit's outline is untouched
+      for (const y of [361, 365, 369, 400]) {
+        expect(at(448, y)[3], `outside the neck row ${y}`).toBe(0);
+        expect(at(500, y)[3], `neck row ${y}`).toBe(255);
+        if (y >= 369) expect(at(453, y)[3], `outfit edge row ${y}`).toBe(128);
+      }
+      expect(report).toMatchObject({ ok: true, widerThanAnnaFrom354: 0 });
+    },
+  );
+});
