+function set(setId: string, name: string, collection = 'modern'): CatalogueSetListItem {
+	return {
+		setId,
+		name,
+		thumbnailUrl: null,
+		backgroundImage: `https://cdn.example.test/${setId}.webp`,
+		foregroundImage: null,
+		collection,
+		area: 'city',
+		venue: 'venue',
+		setting: 'interior',
+		space: 'main',
+		userPosition: 'front',
+		availableStyles: [],
+		variantCounts: { daytime: 1, evening: 0, night: 0, rainy: 0 },
+		backdropId: `backdrop_${setId}`
+	};
+}
+
+const choices: SetChoice[] = [
+	{ ref: 1, set: set('set_a', 'Boutique Hotel · Reception · Looking At Desk') },
+	{ ref: 2, set: set('set_b', 'Park · Picnic Area · Sitting At Table') },
+	{ ref: 3, set: set('set_c', 'Colliseum · Colliseum Entrance', 'ancient_rome') },
+	{ ref: 4, set: set('set_d', 'Station · Platform') }
