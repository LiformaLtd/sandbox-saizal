 		position: absolute;
 		inset: 0;
 	}
@@ -978,6 +1036,17 @@
 		visibility: hidden;
 	}
 
+	/* The last drawn look waits out of sight. While it is held on top, the new pictures load out of sight instead (no fade when
+	   they take over). */
