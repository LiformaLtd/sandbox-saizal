@@ -0,0 +1,750 @@
+// LOCAL DEV ONLY (2026-10-28): an ethnicity outfit plate with the neck "fitted", in place of headNeckPlate.ts when the
+// avatar's outline and white-tee picture are there too. One join for every outfit, open neck to scarf, women and men.
+//
+// Every outfit picture was drawn round a seed's head (European / African). Their jaws are not the avatar's jaw, so a
+// plain paste either shows the seed's jaw edge under a higher jaw (a pale line), leaves a hole where a wider seed jaw
+// was (women's scarves), or mixes two jaws (a soft double jaw). Here, point by point along the jaw:
+//
+//   cloth under the old jaw   (a scarf, a turtleneck, a high collar, or the neck in a garment's shadow - the outfit
+//                             differs from the seed's own white-tee picture there): the band within FIT_REACH px round
+//                             the jaw SLIDES, the same in both pictures, so the lower of the two seed jaws lands on the
+//                             avatar's jaw cut - the cloth hugs the new chin, nothing is painted; the head goes on top,
+//                             cut at its own jaw, fading into the outfit's skin over FEATHER px
+//   a bare neck               nothing moves (the neck's outline and the collar stay exactly where they are): the head
+//                             WITH its own neck covers down to 3 px under the lowest of the three chins (as the live way),
+//                             its neck strip shaded to meet the outfit's neck below, then fades into it over FEATHER px
+//
+// Then, everywhere: the two pictures are mixed and what is left of the old head is cleared (as headNeckPlate.ts); the
+// outfit's skin is recoloured to the avatar's (one colour change, full under the chins, easing out down the chest) and
+// shaded like its own white-tee neck for SHADE_REACH px under the jaw; the avatar's own neck is never laid over cloth.
+// Made once per outfit: each picture's seed jaw (measured once on the seed's white tee, moved by how far the outfit's
+// face sits from the seed's). Made once per avatar: its jaw cut, the band round it, its colour change and shading.
+//
+// Works on 1024×1024 RGBA arrays in the plate frame.
+
+import type { FaceOutline } from './ethnicityPlateMaker';
+import { keepAtSize, type OutfitCollar } from './headNeckPlate';
+import { alignFace, chinLine, faceEdges, jawCut, lum, type JawCut, type Point, type Rgba } from './neckFitJaw';
+
+const W = 1024;
+const N = W * W;
+
+/** px out from the jaw over which the move fades to nothing */
+const FIT_REACH = 40;
+/** dot steps at each end of the jaw line (up the cheeks) over which the move eases to nothing */
+const END_EASE = 2;
+/** samples either side the move is averaged over along the jaw */
+const MOVE_SMOOTH = 6;
+/** the neck's colour change: full for 60 px under the chins, then easing out over 160 px */
+const GAIN_FULL = 60;
+const GAIN_FADE = 160;
+/** a face that matches its seed less than this is not shifted */
+const FACE_MATCH = 0.6;
+/** the shading under the jaw, calibrated on the white tee: px out from the cut, the last SHADE_EASE easing out; both
+ *  pictures are blurred (radius SHADE_BLUR, twice) first, so only soft shading is carried over */
+const SHADE_REACH = 40;
+const SHADE_EASE = 16;
+const SHADE_BLUR = 2;
+/** the move is smoothed over the band (a box of this radius, twice), so it never jumps from one row to the next */
+const MOVE_BLUR = 3;
+/** how far past the old jaw the outfit is read to decide whether it slides (cloth there) or not (a bare neck), and how
+ *  much a pixel must differ from the light seed's own white-tee picture to count as "not a bare neck" */
+const CLOTH_REACH = 14;
+const BARE_DIFF = 28;
+/** the avatar's own neck strip is shaded towards the outfit's neck by a factor in this range */
+const STRIP_MIN = 0.6;
+const STRIP_MAX = 1.15;
+/** under the jaw, over the outfit's skin, the head fades out over this many px past its cut - only where the outfit's
+ *  neck is about as lit as the avatar's own there (fully from LIT_HIGH, not at all below LIT_LOW) */
+const FEATHER = 6;
+const LIT_LOW = 0.72;
+const LIT_HIGH = 0.92;
+
+/** How much a pixel is skin in an outfit: the dark picture clearly darker than the light one (0..1). */
+export function skinWeight(light: Rgba, dark: Rgba, k: number): number {
+	if (light[k + 3] < 128 || dark[k + 3] < 128) return 0;
+	const la = lum(light, k);
+	if (la < 8) return 0;
+	const d = (la - lum(dark, k)) / la;
+	return d <= 0.15 ? 0 : d >= 0.35 ? 1 : (d - 0.15) / 0.2;
+}
+
+/** The mixed picture: light + mix × (dark − light), the light colour where the dark one is see-through. */
+function mixed(light: Rgba, dark: Rgba, mix: readonly number[]): Uint8ClampedArray {
+	const out = new Uint8ClampedArray(N * 4);
+	for (let k = 0; k < N * 4; k += 4) {
+		const solid = dark[k + 3] >= 128;
+		for (let c = 0; c < 3; c++)
+			out[k + c] = solid ? Math.round(light[k + c] + mix[c] * (dark[k + c] - light[k + c])) : light[k + c];
+		out[k + 3] = light[k + 3];
+	}
+	return out;
+}
+
+/** Made once per avatar: per row, per colour, its own white-tee skin / the seeds' white-tee skin mixed with its numbers,
+ *  on the neck under `chins` (smoothed over 13 rows; rows without skin take the nearest). */
+export function rowGain(
+	own: Rgba,
+	base: Rgba,
+	baseDark: Rgba,
+	mix: readonly number[],
+	chins: ArrayLike<number>
+): Float32Array {
+	const M = mixed(base, baseDark, mix);
+	let top = W;
+	let bottom = 0;
+	for (let x = 300; x < 724; x++) {
+		top = Math.min(top, Math.floor(chins[x]) - 10);
+		bottom = Math.max(bottom, Math.ceil(chins[x]) + GAIN_FULL + GAIN_FADE + 10);
+	}
+	const g = new Float32Array(W * 3).fill(NaN);
+	for (let y = Math.max(0, top); y < Math.min(W, bottom); y++) {
+		const r: number[][] = [[], [], []];
+		for (let x = 300; x < 724; x++) {
+			const k = (y * W + x) * 4;
+			if (own[k + 3] < 250 || skinWeight(base, baseDark, k) < 1) continue;
+			const mx = Math.max(own[k], own[k + 1], own[k + 2]);
+			const mn = Math.min(own[k], own[k + 1], own[k + 2]);
+			if (mx < 20 || (mx - mn) / mx < 0.15) continue; // the avatar's own pixel must be skin too (not its tee)
+			for (let c = 0; c < 3; c++) if (M[k + c] > 4) r[c].push(own[k + c] / M[k + c]);
+		}
+		if (r[0].length >= 12) {
+			for (let c = 0; c < 3; c++) {
+				r[c].sort((a, b) => a - b);
+				g[y * 3 + c] = r[c][r[c].length >> 1];
+			}
+		}
+	}
+	const out = new Float32Array(W * 3).fill(1);
+	for (let y = 0; y < W; y++) {
+		for (let c = 0; c < 3; c++) {
+			let s = 0;
+			let n = 0;
+			for (let d = -6; d <= 6; d++) {
+				const v = g[(y + d) * 3 + c];
+				if (y + d >= 0 && y + d < W && !Number.isNaN(v)) {
+					s += v;
+					n++;
+				}
+			}
+			out[y * 3 + c] = n ? s / n : NaN;
+		}
+	}
+	for (let y = 1; y < W; y++)
+		if (Number.isNaN(out[y * 3])) for (let c = 0; c < 3; c++) out[y * 3 + c] = out[(y - 1) * 3 + c];
+	for (let y = W - 2; y >= 0; y--)
+		if (Number.isNaN(out[y * 3])) for (let c = 0; c < 3; c++) out[y * 3 + c] = out[(y + 1) * 3 + c];
+	for (let i = 0; i < out.length; i++) if (Number.isNaN(out[i])) out[i] = 1;
+	return out;
+}
+
+/** What a set needs to fit its outfits: both seeds' jaws (measured once on their white tees, where the neck is clear
+ *  of any collar) and their white-tee face edges. */
+export type FitSeeds = {
+	readonly lightJaw: JawCut;
+	readonly darkJaw: JawCut;
+	readonly lightEdges: Float32Array;
+	readonly darkEdges: Float32Array;
+};
+
+/** `base`/`baseDark` = the seeds' white-tee pictures. */
+export function prepareFitSeeds(
+	lightOutline: FaceOutline,
+	darkOutline: FaceOutline,
+	base: Rgba,
+	baseDark: Rgba
+): FitSeeds {
+	return {
+		lightJaw: jawCut(lightOutline, base, { seed: true }),
+		darkJaw: jawCut(darkOutline, baseDark, { seed: true }),
+		lightEdges: faceEdges(base),
+		darkEdges: faceEdges(baseDark)
+	};
+}
+
+/** One outfit's two seed jaws, as they sit in its own pictures. */
+export type OutfitJaws = { readonly light: JawCut; readonly dark: JawCut };
+
+function shiftedJaw(jaw: JawCut, dx: number, dy: number): JawCut {
+	return { ...jaw, cut: jaw.cut.map((q): Point => [q[0] + dx, q[1] + dy]) };
+}
+
+/**
+ * Made once per outfit: each picture's seed jaw, moved by how far its face sits from the seed's (lined up round the
+ * nose, mouth and chin). The dark picture is lined up with the dark seed AND with the outfit's own light picture - when
+ * it matches its light picture better (it was made from it) it takes the light seed's jaw. A face that matches only
+ * weakly is not shifted.
+ */
+export function outfitJaws(light: Rgba, dark: Rgba, seeds: FitSeeds): OutfitJaws {
+	const lightEdges = faceEdges(light);
+	const fa = alignFace(lightEdges, seeds.lightEdges);
+	const darkEdges = faceEdges(dark);
+	const bd = alignFace(darkEdges, seeds.darkEdges);
+	const ba = alignFace(darkEdges, lightEdges);
+	const fromLight = ba.score > bd.score;
+	const fb = fromLight ? { dx: fa.dx + ba.dx, dy: fa.dy + ba.dy, score: ba.score } : bd;
+	return {
+		light: fa.score >= FACE_MATCH ? shiftedJaw(seeds.lightJaw, fa.dx, fa.dy) : seeds.lightJaw,
+		dark: fb.score >= FACE_MATCH ? shiftedJaw(fromLight ? seeds.lightJaw : seeds.darkJaw, fb.dx, fb.dy) : seeds.darkJaw
+	};
+}
+
+/** A cut's point at a place along the dots. */
+function cutAt(jaw: JawCut, u: number): Point {
+	const { par, cut } = jaw;
+	let lo = 0;
+	let hi = par.length - 1;
+	if (u <= par[0]) return cut[0];
+	if (u >= par[hi]) return cut[hi];
+	while (hi - lo > 1) {
+		const m = (lo + hi) >> 1;
+		if (par[m] <= u) lo = m;
+		else hi = m;
+	}
+	const f = (u - par[lo]) / (par[hi] - par[lo]);
+	return [cut[lo][0] + (cut[hi][0] - cut[lo][0]) * f, cut[lo][1] + (cut[hi][1] - cut[lo][1]) * f];
+}
+
+/**
+ * Per outfit and avatar: how far each point of the avatar's jaw cut moves - as far out as the further of the outfit's
+ * two seed jaws (same place along the dots), so neither old face can show - averaged along the jaw and eased to nothing
+ * up the cheeks.
+ */
+function jawMoves(av: JawCut, jaws: OutfitJaws): Float32Array {
+	const n = av.cut.length;
+	const last = av.par[n - 1];
+	const D = av.cut.map((q, i) => {
+		const [tx, ty] = av.normals[i];
+		const a = cutAt(jaws.light, av.par[i]);
+		const b = cutAt(jaws.dark, av.par[i]);
+		// out along the avatar's jaw normal as far as the further of the two, along the jaw their average (so the move
+		// changes smoothly where the two jaws cross)
+		const out = Math.max((a[0] - q[0]) * -ty + (a[1] - q[1]) * tx, (b[0] - q[0]) * -ty + (b[1] - q[1]) * tx);
+		const along = ((a[0] - q[0]) * tx + (a[1] - q[1]) * ty + (b[0] - q[0]) * tx + (b[1] - q[1]) * ty) / 2;
+		return [out * -ty + along * tx, out * tx + along * ty];
+	});
+	const moves = new Float32Array(n * 2);
+	for (let i = 0; i < n; i++) {
+		let sx = 0;
+		let sy = 0;
+		let m = 0;
+		for (let j = Math.max(0, i - MOVE_SMOOTH); j <= Math.min(n - 1, i + MOVE_SMOOTH); j++) {
+			sx += D[j][0];
+			sy += D[j][1];
+			m++;
+		}
+		const u = Math.min(av.par[i], last - av.par[i]) / END_EASE;
+		const e = u >= 1 ? 1 : u <= 0 ? 0 : u * u * (3 - 2 * u);
+		moves[2 * i] = (sx / m) * e;
+		moves[2 * i + 1] = (sy / m) * e;
+	}
+	return moves;
+}
+
+/** Made once per avatar: every pixel round its jaw - the nearest cut point, how much of the move it takes (all of it
+ *  at and inside the cut, fading to nothing FIT_REACH px out), and whether it is under the jaw between the jaw corners
+ *  (there nothing of the old head can show, so nothing is cleared). */
+type FitBand = {
+	readonly idx: Int32Array;
+	readonly bi: Int32Array;
+	readonly w: Float32Array;
+	readonly free: Uint8Array;
+	/** how far out of the cut (+) or into it (−) */
+	readonly dist: Float32Array;
+	/** the band's bounding box: left, top, width, height */
+	readonly grid: readonly [number, number, number, number];
+};
+
+function fitBand(jaw: JawCut): FitBand {
+	const Q = jaw.cut;
+	const n = Q.length;
+	const xs = Q.map((q) => q[0]);
+	const ys = Q.map((q) => q[1]);
+	const x0 = Math.max(0, Math.floor(Math.min(...xs)) - FIT_REACH - 2);
+	const x1 = Math.min(W, Math.ceil(Math.max(...xs)) + FIT_REACH + 2);
+	const y0 = Math.max(0, Math.floor(Math.min(...ys)) - 14);
+	const y1 = Math.min(W, Math.ceil(Math.max(...ys)) + FIT_REACH + 2);
+	const idx: number[] = [];
+	const bis: number[] = [];
+	const ws: number[] = [];
+	const free: number[] = [];
+	const dist: number[] = [];
+	for (let y = y0; y < y1; y++) {
+		for (let x = x0; x < x1; x++) {
+			const px = x + 0.5;
+			const py = y + 0.5;
+			let best = Infinity;
+			let bi = 0;
+			for (let i = 0; i < n; i++) {
+				const dd = (px - Q[i][0]) ** 2 + (py - Q[i][1]) ** 2;
+				if (dd < best) {
+					best = dd;
+					bi = i;
+				}
+			}
+			const [tx, ty] = jaw.normals[bi];
+			const d = (px - Q[bi][0]) * -ty + (py - Q[bi][1]) * tx; // + = outside the jaw
+			if (d < -12 || d >= FIT_REACH) continue;
+			idx.push(y * W + x);
+			bis.push(bi);
+			ws.push(d <= 0 ? 1 : 1 - d / FIT_REACH);
+			free.push(bi >= jaw.from && bi <= jaw.to ? 1 : 0);
+			dist.push(d);
+		}
+	}
+	let gx0 = W;
+	let gx1 = 0;
+	let gy0 = W;
+	let gy1 = 0;
+	for (const i of idx) {
+		gx0 = Math.min(gx0, i % W);
+		gx1 = Math.max(gx1, i % W);
+		gy0 = Math.min(gy0, (i / W) | 0);
+		gy1 = Math.max(gy1, (i / W) | 0);
+	}
+	return {
+		idx: Int32Array.from(idx),
+		bi: Int32Array.from(bis),
+		w: Float32Array.from(ws),
+		free: Uint8Array.from(free),
+		dist: Float32Array.from(dist),
+		grid: [gx0, gy0, gx1 - gx0 + 1, gy1 - gy0 + 1]
+	};
+}
+
+/** Per outfit and avatar: how far each band pixel moves (smoothed over the band, so it never jumps row to row). */
+function moveField(band: FitBand, D: Float32Array): { dx: Float32Array; dy: Float32Array } {
+	const { idx, bi, w } = band;
+	const [x0, y0, gw, gh] = band.grid;
+	const blur = (f: Float32Array): Float32Array => {
+		const R = MOVE_BLUR;
+		for (let pass = 0; pass < 2; pass++) {
+			const t = new Float32Array(f.length);
+			for (let y = 0; y < gh; y++) {
+				let s = 0;
+				for (let x = -R; x < gw + R; x++) {
+					if (x + R < gw) s += f[y * gw + x + R];
+					if (x - R - 1 >= 0) s -= f[y * gw + x - R - 1];
+					if (x >= 0 && x < gw) t[y * gw + x] = s / (2 * R + 1);
+				}
+			}
+			const u = new Float32Array(f.length);
+			for (let x = 0; x < gw; x++) {
+				let s = 0;
+				for (let y = -R; y < gh + R; y++) {
+					if (y + R < gh) s += t[(y + R) * gw + x];
+					if (y - R - 1 >= 0) s -= t[(y - R - 1) * gw + x];
+					if (y >= 0 && y < gh) u[y * gw + x] = s / (2 * R + 1);
+				}
+			}
+			f = u;
+		}
+		return f;
+	};
+	let fx: Float32Array = new Float32Array(gw * gh);
+	let fy: Float32Array = new Float32Array(gw * gh);
+	for (let j = 0; j < idx.length; j++) {
+		const g = (((idx[j] / W) | 0) - y0) * gw + ((idx[j] % W) - x0);
+		fx[g] = w[j] * D[2 * bi[j]];
+		fy[g] = w[j] * D[2 * bi[j] + 1];
+	}
+	fx = blur(fx);
+	fy = blur(fy);
+	const dx = new Float32Array(idx.length);
+	const dy = new Float32Array(idx.length);
+	for (let j = 0; j < idx.length; j++) {
+		const g = (((idx[j] / W) | 0) - y0) * gw + ((idx[j] % W) - x0);
+		dx[j] = fx[g];
+		dy[j] = fy[g];
+	}
+	return { dx, dy };
+}
+
+/**
+ * Per outfit and avatar, per point of the avatar's jaw cut: whether the outfit slides there (1) or not (0). Read past
+ * the old (outer) jaw, along the jaw normal and straight down (at a jaw corner the normal points sideways, past a
+ * collar below): the outfit's light picture is "not a bare neck" where it is solid and differs from the light seed's own
+ * white-tee picture - cloth, or the neck in a garment's shadow - and slides; over a bare neck or background it does not
+ * (the avatar's own neck covers the old chin instead, as the live way). Averaged along the jaw.
+ */
+function slideWeights(jaw: JawCut, D: Float32Array, light: Rgba, base: Rgba): Float32Array {
+	const n = jaw.cut.length;
+	const raw = new Float32Array(n);
+	for (let q = 0; q < n; q++) {
+		const [tx, ty] = jaw.normals[q];
+		const ox = jaw.cut[q][0] + D[2 * q];
+		const oy = jaw.cut[q][1] + D[2 * q + 1];
+		const share = (dx: number, dy: number): number => {
+			let c = 0;
+			let m = 0;
+			for (let t = 1; t <= CLOTH_REACH; t++) {
+				const x = Math.floor(ox + dx * t);
+				const y = Math.floor(oy + dy * t);
+				if (x < 0 || y < 0 || x >= W || y >= W) continue;
+				const k = (y * W + x) * 4;
+				if (light[k + 3] < 128 && base[k + 3] < 128) continue;
+				m++;
+				const diff = Math.max(
+					Math.abs(light[k] - base[k]),
+					Math.abs(light[k + 1] - base[k + 1]),
+					Math.abs(light[k + 2] - base[k + 2])
+				);
+				if (light[k + 3] >= 200 && (base[k + 3] < 128 || diff > BARE_DIFF)) c++;
+			}
+			return m ? c / m : 0;
+		};
+		const f = Math.max(share(-ty, tx), share(0, 1));
+		raw[q] = Math.min(1, Math.max(0, (f - 0.2) / 0.4));
+	}
+	return raw.map((_, q) => {
+		let s = 0;
+		let k = 0;
+		for (let j = Math.max(0, q - 10); j <= Math.min(n - 1, q + 10); j++) {
+			s += raw[j];
+			k++;
+		}
+		return s / k;
+	});
+}
+
+/** Everything made once per avatar. */
+export type FitAvatar = {
+	readonly head: Rgba;
+	readonly jaw: JawCut;
+	readonly band: FitBand;
+	/** the neck colour change, per colour */
+	readonly gain: readonly [number, number, number];
+	/** per column, the row under which the colour change starts to fade */
+	readonly gainTop: Float32Array;
+	/** the shading right under the jaw, calibrated on the white tee: a factor per pixel and colour, and how much of it
+	 *  applies (null while it is being made) */
+	readonly shade: {
+		readonly ratio: Float32Array;
+		readonly weight: Float32Array;
+	} | null;
+	/** the light seed's white-tee picture (what a bare neck looks like in the outfit pictures) */
+	readonly base: Rgba;
+	/** per pixel, how far out of the jaw cut (NaN outside the band) */
+	readonly distPx: Float32Array;
+};
+
+/**
+ * `head` = the avatar's head+neck picture, `own` = its white-tee picture, `base`/`baseDark` = the seeds' white-tee
+ * pictures, `headShape` = the set's head shape, `mix` = its three numbers.
+ *
+ * The shading right under its jaw is calibrated on the white tee: the fit is run on the seeds' white tees, and in the
+ * band under the jaw (between the jaw corners, SHADE_REACH px out) every pixel of its own white-tee picture is divided by
+ * the fitted one, per colour - the soft shadow and beard fringe its own neck has there. Every outfit's skin in that band
+ * is multiplied by it (fading out over the last SHADE_EASE px), so on the white tee the plate is its own picture, and a
+ * collar's or scarf's own shading is kept on top.
+ */
+export function prepareFitAvatar(args: {
+	readonly head: Rgba;
+	readonly outline: FaceOutline;
+	readonly own: Rgba;
+	readonly base: Rgba;
+	readonly baseDark: Rgba;
+	readonly headShape: Rgba;
+	readonly seeds: FitSeeds;
+	readonly lightOutline: FaceOutline;
+	readonly darkOutline: FaceOutline;
+	readonly mix: readonly [number, number, number];
+}): FitAvatar {
+	const jaw = jawCut(args.outline, args.head, { steady: true });
+	const own = chinLine(args.outline);
+	const light = chinLine(args.lightOutline);
+	const dark = chinLine(args.darkOutline);
+	const gainTop = own.map((v, x) => Math.max(v, light[x], dark[x]) + 3);
+	const band = fitBand(jaw);
+	// one colour change per avatar: the row changes down the middle of its neck (12-60 px under the chins), their
+	// median - row by row it banded across open chests, where the white tee has no skin to measure
+	const rows = rowGain(args.own, args.base, args.baseDark, args.mix, gainTop);
+	const top = Math.round(gainTop[W / 2]);
+	const gain = [0, 1, 2].map((c) => {
+		const v: number[] = [];
+		for (let y = top + 12; y <= top + 60; y++) v.push(rows[y * 3 + c]);
+		v.sort((a, b) => a - b);
+		return v[v.length >> 1];
+	}) as [number, number, number];
+	const distPx = new Float32Array(N).fill(NaN);
+	band.idx.forEach((i, j) => {
+		distPx[i] = band.dist[j];
+	});
+	const unshaded: FitAvatar = {
+		head: args.head,
+		jaw,
+		band,
+		gain,
+		gainTop,
+		shade: null,
+		base: args.base,
+		distPx
+	};
+	const fitted = stackFitPlate(
+		args.base,
+		args.baseDark,
+		args.headShape,
+		{ line: [], keep: [] },
+		args.mix,
+		unshaded,
+		outfitJaws(args.base, args.baseDark, args.seeds),
+		{ head: false }
+	);
+	let x0 = W;
+	let x1 = 0;
+	let y0 = W;
+	let y1 = 0;
+	for (let j = 0; j < band.idx.length; j++) {
+		if (!band.free[j]) continue;
+		const x = band.idx[j] % W;
+		const y = (band.idx[j] / W) | 0;
+		x0 = Math.min(x0, x);
+		x1 = Math.max(x1, x);
+		y0 = Math.min(y0, y);
+		y1 = Math.max(y1, y);
+	}
+	const ownBlur = blurBox(args.own, x0 - 8, y0 - 8, x1 + 8, y1 + 8);
+	const fittedBlur = blurBox(fitted, x0 - 8, y0 - 8, x1 + 8, y1 + 8);
+	const ratio = new Float32Array(N * 3).fill(1);
+	const weight = new Float32Array(N);
+	for (let j = 0; j < band.idx.length; j++) {
+		if (!band.free[j]) continue;
+		const i = band.idx[j];
+		const k = i * 4;
+		const d = band.dist[j];
+		if (d < -1.5 || d > SHADE_REACH || args.own[k + 3] < 250 || fitted[k + 3] < 250) continue;
+		for (let c = 0; c < 3; c++)
+			ratio[i * 3 + c] = Math.min(1.6, Math.max(0.6, (ownBlur[k + c] + 1) / (fittedBlur[k + c] + 1)));
+		const t = d <= SHADE_REACH - SHADE_EASE ? 0 : (d - SHADE_REACH + SHADE_EASE) / SHADE_EASE;
+		weight[i] = 1 - t * t * (3 - 2 * t);
+	}
+	return { ...unshaded, shade: { ratio, weight } };
+}
+
+/** A box blur (radius SHADE_BLUR), twice, of the colours inside [x0, x1] × [y0, y1]; see-through pixels left out. */
+function blurBox(P: Rgba, x0: number, y0: number, x1: number, y1: number): Float32Array {
+	let cur = Float32Array.from(P as ArrayLike<number>);
+	for (let pass = 0; pass < 2; pass++) {
+		const next = Float32Array.from(cur);
+		for (let y = Math.max(2, y0); y <= Math.min(W - 3, y1); y++) {
+			for (let x = Math.max(2, x0); x <= Math.min(W - 3, x1); x++) {
+				const k = (y * W + x) * 4;
+				if (P[k + 3] < 250) continue;
+				let r = 0;
+				let g = 0;
+				let b = 0;
+				let n = 0;
+				for (let dy = -SHADE_BLUR; dy <= SHADE_BLUR; dy++) {
+					for (let dx = -SHADE_BLUR; dx <= SHADE_BLUR; dx++) {
+						const q = k + (dy * W + dx) * 4;
+						if (P[q + 3] < 250) continue;
+						r += cur[q];
+						g += cur[q + 1];
+						b += cur[q + 2];
+						n++;
+					}
+				}
+				next[k] = r / n;
+				next[k + 1] = g / n;
+				next[k + 2] = b / n;
+			}
+		}
+		cur = next;
+	}
+	return cur;
+}
+
+/** Bilinear read of an RGBA picture at a point (pixel centres at +0.5), colour weighted by see-through. */
+function readPixel(P: Rgba, x: number, y: number, o: Float64Array): void {
+	const xa = Math.floor(x - 0.5);
+	const ya = Math.floor(y - 0.5);
+	const fx = x - 0.5 - xa;
+	const fy = y - 0.5 - ya;
+	let r = 0;
+	let g = 0;
+	let b = 0;
+	let a = 0;
+	for (const [dx, dy, w] of [
+		[0, 0, (1 - fx) * (1 - fy)],
+		[1, 0, fx * (1 - fy)],
+		[0, 1, (1 - fx) * fy],
+		[1, 1, fx * fy]
+	]) {
+		const xx = Math.min(W - 1, Math.max(0, xa + dx));
+		const yy = Math.min(W - 1, Math.max(0, ya + dy));
+		const k = (yy * W + xx) * 4;
+		const aw = w * P[k + 3];
+		r += aw * P[k];
+		g += aw * P[k + 1];
+		b += aw * P[k + 2];
+		a += aw;
+	}
+	if (a > 0) {
+		o[0] = r / a;
+		o[1] = g / a;
+		o[2] = b / a;
+	} else o[0] = o[1] = o[2] = 0;
+	o[3] = a;
+}
+
+/**
+ * One ethnicity plate. `light`/`dark` = the outfit's endpoint plates, `headShape` = the set's head shape, `collar` =
+ * the outfit's collar file, `mix` = the ethnicity's numbers, `avatar` from prepareFitAvatar, `jaws` from outfitJaws.
+ * `head: false` leaves the head off (the white-tee calibration).
+ */
+export function stackFitPlate(
+	light: Rgba,
+	dark: Rgba,
+	headShape: Rgba,
+	collar: OutfitCollar,
+	mix: readonly [number, number, number],
+	avatar: FitAvatar,
+	jaws: OutfitJaws,
+	opts: { readonly head?: boolean } = {}
+): Uint8ClampedArray<ArrayBuffer> {
+	for (const p of [light, dark, headShape, avatar.head]) {
+		if (p.length !== N * 4) throw new Error(`fitted plates need ${W}x${W} RGBA inputs`);
+	}
+	const withHead = opts.head !== false;
+	const { band, jaw, gain, gainTop, shade, head } = avatar;
+	const kept = keepAtSize(collar.keep, W);
+	// the outfit slides only where cloth (or the neck in a garment's shadow) sits under the old jaw: fully from a weight
+	// of 0.7, not at all under 0.3; one move for both pictures (their clothes are lined up, so they move together)
+	const D = jawMoves(jaw, jaws);
+	const slide = slideWeights(jaw, D, light, avatar.base);
+	const Dw = D.map((v, q) => v * Math.min(1, Math.max(0, (slide[q >> 1] - 0.3) / 0.4)));
+	const M = moveField(band, Dw);
+	const A = new Uint8ClampedArray(light as ArrayLike<number>);
+	const B = new Uint8ClampedArray(dark as ArrayLike<number>);
+	const S = new Uint8ClampedArray(headShape as ArrayLike<number>);
+	const K = new Uint8Array(kept);
+	const free = new Uint8Array(N); // under the jaw where it slides: nothing of the old head is left there
+	const slidePx = new Float32Array(N);
+	const fadeSlide = new Float32Array(N);
+	const o = new Float64Array(4);
+	for (let j = 0; j < band.idx.length; j++) {
+		const i = band.idx[j];
+		const k = i * 4;
+		const sx = (i % W) + 0.5 + M.dx[j];
+		const sy = ((i / W) | 0) + 0.5 + M.dy[j];
+		readPixel(light, sx, sy, o);
+		for (let c = 0; c < 4; c++) A[k + c] = o[c];
+		readPixel(dark, sx, sy, o);
+		for (let c = 0; c < 4; c++) B[k + c] = o[c];
+		const s = Math.min(W - 1, Math.max(0, Math.floor(sy))) * W + Math.min(W - 1, Math.max(0, Math.floor(sx)));
+		for (let c = 0; c < 3; c++) S[k + c] = headShape[s * 4 + c];
+		K[i] = kept[s];
+		const w = slide[band.bi[j]];
+		slidePx[i] = w;
+		if (band.free[j] && w >= 0.5) free[i] = 1;
+		if (band.free[j]) {
+			const t = Math.min(1, Math.max(0, band.dist[j] / FEATHER));
+			fadeSlide[i] = 1 - t * t * (3 - 2 * t);
+		}
+	}
+
+	// pass 1: the outfit, mixed, the old head cleared (as headNeckPlate.ts) except where it slides under the jaw
+	const out = new Uint8ClampedArray(N * 4);
+	const covered = new Float32Array(N); // the outfit's see-through value
+	const cleared = new Uint8Array(N); // the old face was cleared here
+	for (let i = 0; i < N; i++) {
+		const k = i * 4;
+		const y = (i / W) | 0;
+		const oldHead = !free[i] && S[k + 2] >= 128;
+		const above = !free[i] && S[k + 1] >= 128;
+		const jawZone = S[k] >= 128;
+		let keep = true;
+		if (oldHead) keep = jawZone && K[i] === 1;
+		else if (above && !jawZone) keep = B[k + 3] >= 128;
+		const ab = keep ? A[k + 3] / 255 : 0;
+		covered[i] = ab;
+		cleared[i] = oldHead ? 1 : 0;
+		if (ab <= 0) continue;
+		const isMixed = B[k + 3] >= 128 && !oldHead;
+		// skin is recoloured to the avatar's own: full under the chins, easing out down the chest, and shaded as its own
+		// white-tee neck under the jaw
+		const sw = isMixed ? skinWeight(A, B, k) : 0;
+		const t = Math.min(1, Math.max(0, (y - gainTop[i % W] - GAIN_FULL) / GAIN_FADE));
+		const f = sw * (1 - t * t * (3 - 2 * t));
+		for (let c = 0; c < 3; c++) {
+			let m = isMixed ? A[k + c] + mix[c] * (B[k + c] - A[k + c]) : A[k + c];
+			if (f > 0) m *= 1 + f * (gain[c] - 1);
+			if (sw > 0 && shade && shade.weight[i] > 0) m *= 1 + sw * shade.weight[i] * (shade.ratio[i * 3 + c] - 1);
+			out[k + c] = Math.round(m);
+		}
+		out[k + 3] = Math.round(ab * 255);
+	}
+
+	// the avatar's own neck strip (on a bare neck, between its jaw and the line where the outfit takes over) is shaded to
+	// meet the outfit's neck just below that line: per column, the outfit's skin 2-7 px under the line / the head
+	// picture's there (median), smoothed across 21 columns
+	const strip = new Float32Array(W).fill(1);
+	if (withHead) {
+		const raw = new Float32Array(W).fill(NaN);
+		for (let x = 360; x < 664; x++) {
+			const v: number[] = [];
+			for (let y = Math.ceil(gainTop[x]) + 2; y <= Math.ceil(gainTop[x]) + 7; y++) {
+				const k = (y * W + x) * 4;
+				if (out[k + 3] < 250 || head[k + 3] < 200 || skinWeight(A, B, k) < 0.5) continue;
+				const lh = lum(head, k);
+				if (lh > 8) v.push(lum(out, k) / lh);
+			}
+			if (v.length >= 3) {
+				v.sort((a, b) => a - b);
+				raw[x] = v[v.length >> 1];
+			}
+		}
+		for (let x = 360; x < 664; x++) {
+			const v: number[] = [];
+			for (let d = -10; d <= 10; d++) if (!Number.isNaN(raw[x + d])) v.push(raw[x + d]);
+			if (v.length) {
+				v.sort((a, b) => a - b);
+				strip[x] = Math.min(STRIP_MAX, Math.max(STRIP_MIN, v[v.length >> 1]));
+			}
+		}
+	}
+
+	// pass 2: the avatar's head on top
+	const hc = [0, 0, 0];
+	for (let i = 0; withHead && i < N; i++) {
+		const k = i * 4;
+		const y = (i / W) | 0;
+		const x = i % W;
+		const ab = covered[i];
+		// where nothing slides (a bare neck): the head WITH its own neck down to 3 px under the lowest of the three chins
+		// (a line running on flat past the jaw ends, as the live way), fading out over FEATHER px below it; where the
+		// outfit slides: the head cut at its own jaw, fading out over FEATHER px past the cut; in between, mixed by the
+		// slide weight. Where the old face was cleared the head is always drawn in full (no gap), and its own neck is never
+		// laid over the outfit's cloth (a collar or scarf stays the outfit's)
+		const c = slidePx[i];
+		const below = y + 0.5 - gainTop[x];
+		const tN = Math.min(1, Math.max(0, below / FEATHER));
+		const fadeN = below <= 0 ? 0 : 1 - tN * tN * (3 - 2 * tN);
+		const onCloth = ab > 0 && (B[k + 3] < 128 || skinWeight(A, B, k) < 0.5);
+		let cover = cleared[i] ? 1 : (1 - c) * (!onCloth && below <= 0 ? 1 : jaw.mask[i]) + c * jaw.mask[i];
+		// its own neck strip, shaded towards the outfit's neck below (none at the jaw cut, all of it at the line)
+		let sh = 1;
+		if (strip[x] !== 1 && c < 1 && jaw.mask[i] < 1) {
+			const d = avatar.distPx[i];
+			const r = Number.isNaN(d) || d <= 0 ? 0 : below >= 0 ? 1 : d / (d - below);
+			sh = 1 + (1 - c) * r * (strip[x] - 1);
+		}
+		for (let q = 0; q < 3; q++) hc[q] = head[k + q] * sh;
+		// the fade only over the outfit's skin, and only where its neck is about as lit as the avatar's own (shaded) neck
+		// there: under a scarf's or collar's shadow its lit neck would show as a light band, so there the edge stays sharp
+		const soft = (1 - c) * fadeN + c * fadeSlide[i];
+		if (soft > 0 && ab > 0) {
+			const lh = 0.299 * hc[0] + 0.587 * hc[1] + 0.114 * hc[2];
+			const lit = lh > 8 ? lum(out, k) / lh : 1;
+			const f =
+				(B[k + 3] >= 128 ? skinWeight(A, B, k) : 0) * Math.min(1, Math.max(0, (lit - LIT_LOW) / (LIT_HIGH - LIT_LOW)));
+			if (f > 0) cover += f * (Math.max(cover, soft) - cover);
+		}
+		const at = (head[k + 3] / 255) * cover;
+		if (at <= 0) continue;
+		const a = at + ab * (1 - at);
+		for (let q = 0; q < 3; q++) out[k + q] = Math.round((hc[q] * at + out[k + q] * ab * (1 - at)) / a);
+		out[k + 3] = Math.round(a * 255);
+	}
+	return out;
+}
diff --git a/src/lib/server/catalog/neckFitJaw.ts b/src/lib/server/catalog/neckFitJaw.ts
