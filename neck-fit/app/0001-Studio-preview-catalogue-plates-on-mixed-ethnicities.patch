 // authoring avatar-sets/{id}/… (never public race-outfits). The version is part of the address so a
 // browser never reuses an answer saved before the inputs changed; plates made from them are cached under it too.
 const INPUT = '/api/studio/avatar-set-clothes/input';
-/** Bump when a maker input's bytes change under the same kind and name (face PNG → head WebP). */
-export const RACE_INPUT_VERSION = 'avatar-set-maker-2';
+/**
+ * Bump when a maker input's bytes change under the same kind and name (2: face PNG → head WebP; 3: catalogue plates on
+ * mixed ethnicities made on the server, fittedPlateUrl). A new version keeps older cached plates from being reused.
+ */
+export const RACE_INPUT_VERSION = 'avatar-set-maker-3';
+
+/** A catalogue outfit's plate for a mixed ethnicity, made on the API by the same bake a character save runs. */
+const FITTED = '/api/studio/avatar-set-clothes/fitted';
+
+export function fittedPlateUrl(
+	outfit: string,
+	race: string,
+	avatarSetId: string,
+	size: number,
+	format: 'image/webp' | 'image/png'
+): string {
+	const query = new URLSearchParams({
+		v: RACE_INPUT_VERSION,
+		avatarSetId,
+		outfit,
+		race,
+		size: String(size),
+		format: format === 'image/png' ? 'png' : 'webp'
+	});
+	return `${FITTED}?${query}`;
+}
 
