+/** `{ race: [outfit, ...] }` for every race folder of one pair that holds png plates. */
+async function listSet(dir: string): Promise<Record<string, string[]>> {
+	const out: Record<string, string[]> = {};
+	let races: string[];
+	try {
+		races = (await fs.readdir(dir, { withFileTypes: true }))
+			.filter((d) => d.isDirectory() && SAFE.test(d.name))
+			.map((d) => d.name)
+			.sort();
+	} catch {
+		return out;
+	}
+	for (const race of races) {
+		const files = await fs.readdir(path.join(dir, race));
+		const outfits = files
+			.filter((f) => f.endsWith('.png') && SAFE.test(f.slice(0, -4)))
+			.map((f) => f.slice(0, -4))
+			.sort();
