@@ -0,0 +1,110 @@
+// Server copy of the Studio's stacked ethnicity plate (app src/lib/avatarSetClothes/headNeckPlate.ts), used by
+// resolveOrBakeAvatarSetClothes on character save so the saved plate matches the preview. LOCAL DEV ONLY (2026-10-23,
+// clothing by the jaw from the outfit file 2026-10-26): an ethnicity outfit plate stacked from pictures made ahead of
+// time, in place of the maker (ethnicityPlateMaker.ts) when those pictures exist. One pass over the pixels, no
+// searching or blurring:
+//
+//   outfit   the light and dark endpoint plates mixed with the ethnicity's three numbers, out = A + t*(B-A) per channel;
+//            where the dark plate is see-through its colour means nothing, so the light plate's colour is kept
+//   old head cleared from the outfit with the set's head shape (made once per set; blue = the light endpoint's own head
+//            above the chin cut, green = above the chin cut, red = the jaw zone just above it):
+//            - inside the old head only the outfit's clothing by the jaw stays (a scarf or hood): the pixels its collar
+//              file lists, found once with the maker's own garment test. They keep the light plate's colour, as in the
+//              maker. So the old head cannot show round a narrower new face
+//            - higher up, outside the old head, only what both plates paint stays, so a hat only one of them wears goes,
+//              as in the maker
+//   head     the avatar's head+neck picture (made once per avatar: its own head, neck fading to clear at the tee collar,
+//            the rest clear) laid on top, its neck cut off at the outfit's collar line so a high collar or scarf is never
+//            covered. The line starts below every face's chin in the set, so it never cuts an avatar's chin
+//
+// Works on size×size RGBA arrays (canonical 1024; preview 256/512). The collar file is always in the 1024 frame.
+
+export type HeadNeckPlateSize = 256 | 512 | 1024;
+
+/**
+ * One outfit's collar file (made once per outfit, shared by every ethnicity): `line` is the row where clothing starts
+ * under the chin, one per column (1024 = no clothing); `keep` lists the clothing over the old head as runs [y, x0, x1).
+ */
+export type OutfitCollar = {
+	readonly line: ArrayLike<number>;
+	readonly keep: ArrayLike<readonly [number, number, number]>;
+};
+
+type Rgba = ArrayLike<number>;
+
+const FRAME = 1024;
+/** Rows over which the neck fades out just above the collar line (1024 frame). */
+const COLLAR_SOFT = 3;
+
+/** The 1024-frame collar line at this plate size, per column. */
+export function collarAtSize(line: ArrayLike<number>, size: number): Float64Array {
+	const out = new Float64Array(size);
+	const k = FRAME / size;
+	for (let x = 0; x < size; x++) out[x] = line[Math.min(FRAME - 1, Math.floor((x + 0.5) * k))] / k;
+	return out;
+}
+
+/** The clothing kept over the old head, as a size×size mask. */
+export function keepAtSize(keep: OutfitCollar['keep'], size: number): Uint8Array {
+	const out = new Uint8Array(size * size);
+	const k = size / FRAME;
+	for (let r = 0; r < keep.length; r++) {
+		const [y, x0, x1] = keep[r];
+		const row = Math.min(size - 1, Math.floor(y * k));
+		const from = Math.floor(x0 * k);
+		const to = Math.min(size, Math.max(from + 1, Math.ceil(x1 * k)));
+		out.fill(1, row * size + from, row * size + to);
+	}
+	return out;
+}
+
+/**
+ * One ethnicity plate. `light`/`dark` are the outfit's endpoint plates, `headNeck` the avatar's head+neck picture and
+ * `headShape` the set's head shape, all size×size RGBA in the plate frame; `collar` is the outfit's collar file; `mix`
+ * the ethnicity's three numbers.
+ */
+export function stackHeadNeckPlate(
+	light: Rgba,
+	dark: Rgba,
+	headNeck: Rgba,
+	headShape: Rgba,
+	collar: OutfitCollar,
+	mix: readonly [number, number, number],
+	size: HeadNeckPlateSize
+): Uint8ClampedArray<ArrayBuffer> {
+	const n = size * size;
+	for (const p of [light, dark, headNeck, headShape]) {
+		if (p.length !== n * 4) throw new Error(`head+neck plates need ${size}x${size} RGBA inputs`);
+	}
+	const line = collarAtSize(collar.line, size);
+	const kept = keepAtSize(collar.keep, size);
+	const soft = Math.max(1, (COLLAR_SOFT * size) / FRAME);
+	const out = new Uint8ClampedArray(n * 4);
+	for (let y = 0; y < size; y++) {
+		for (let x = 0; x < size; x++) {
+			const i = y * size + x;
+			const k = i * 4;
+			// the outfit, with the old head cleared
+			const jaw = headShape[k] >= 128;
+			const above = headShape[k + 1] >= 128;
+			const oldHead = headShape[k + 2] >= 128;
+			let keep = true;
+			if (oldHead) keep = jaw && kept[i] === 1;
+			else if (above && !jaw) keep = dark[k + 3] >= 128;
+			const ab = keep ? light[k + 3] / 255 : 0;
+			// the head+neck on top, cut off at the collar
+			const cut = Math.min(1, Math.max(0, (line[x] - y) / soft));
+			const at = (headNeck[k + 3] / 255) * cut;
+			const a = at + ab * (1 - at);
+			if (a <= 0) continue;
+			// clothing kept over the old head keeps the light plate's own colour
+			const mixed = dark[k + 3] >= 128 && !oldHead;
+			for (let c = 0; c < 3; c++) {
+				const m = mixed ? Math.round(light[k + c] + mix[c] * (dark[k + c] - light[k + c])) : light[k + c];
+				out[k + c] = Math.round((headNeck[k + c] * at + m * ab * (1 - at)) / a);
+			}
+			out[k + 3] = Math.round(a * 255);
+		}
+	}
+	return out;
+}
