+
+afterEach(() => vi.restoreAllMocks());
+
+describe('public set suggestions', () => {
+	it('numbers each set with its collection for the model', () => {
+		expect(setChoicePromptLines(choices.slice(2, 3))).toEqual([
+			'3: Colliseum · Colliseum Entrance (ancient rome)'
+		]);
+	});
+
+	it('turns the model numbers into sets, best first, without repeats', () => {
+		expect(suggestedSetsFromRefs([2, 1, 2], choices).map((row) => row.setId)).toEqual(['set_b', 'set_a']);
+	});
+
+	it('drops numbers that are not in the list and says so', () => {
+		const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+		expect(suggestedSetsFromRefs([99, 1], choices).map((row) => row.setId)).toEqual(['set_a']);
+		expect(warn).toHaveBeenCalledWith(expect.stringContaining('not in the list'), {
+			unknown: [99],
+			offered: 4
+		});
+	});
+
+	it('keeps at most three suggestions', () => {
+		expect(suggestedSetsFromRefs([1, 2, 3, 4], choices)).toHaveLength(MAX_SUGGESTED_SETS);
+	});
+
+	it('replaces the numbers with the sets in the reply to the Studio', () => {
+		const reply = setupDetailsResponse({ title: 'Check-in', suggestedSetRefs: [1] }, choices);
+		expect(reply).toEqual({
+			title: 'Check-in',
+			suggestedSets: [
+				{
+					setId: 'set_a',
+					name: 'Boutique Hotel · Reception · Looking At Desk',
+					thumbnailUrl: null,
+					backgroundImage: 'https://cdn.example.test/set_a.webp',
+					foregroundImage: null,
+					backdropId: 'backdrop_set_a',
+					collection: 'modern',
+					venue: 'venue',
+					setting: 'interior'
+				}
+			]
+		});
+		expect(reply).not.toHaveProperty('suggestedSetRefs');
+	});
+});
