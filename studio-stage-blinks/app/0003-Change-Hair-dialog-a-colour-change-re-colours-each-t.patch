diff --git a/packages/experience-studio/src/components/HairContactShadow.svelte b/packages/experience-studio/src/components/HairContactShadow.svelte
index 65b6560..fcabe6a 100644
--- a/packages/experience-studio/src/components/HairContactShadow.svelte
+++ b/packages/experience-studio/src/components/HairContactShadow.svelte
@@ -31,9 +31,50 @@
 		if (composited) return composited;
 		return (layer === 'hair' ? hairUrl : clothesUrl).trim();
 	}
+
+	/**
+	 * The finished picture this layer last showed. When the hair or outfit changes, it stays until the next one is made and
+	 * decoded, so a tile never empties in between (2026-10-22).
+	 */
+	let held = $state('');
+	const ready = $derived(
+		clothesUrl.trim() && hairUrl.trim() ? peekHairContactPlates(clothesUrl, hairUrl) : null
+	);
+	const src = $derived(ready ? shownSrc(ready) : held);
+	$effect(() => {
+		const clothes = clothesUrl.trim();
+		const hair = hairUrl.trim();
+		if (!clothes || !hair) {
+			held = '';
+			return;
+		}
+		if (ready) {
+			held = shownSrc(ready);
+			return;
+		}
+		let cancelled = false;
+		void hairContactPlates(clothes, hair).then(async (plates) => {
+			if (cancelled) return;
+			const next = shownSrc(plates);
+			await decodedImage(next);
+			if (!cancelled) held = next;
+		});
+		return () => {
+			cancelled = true;
+		};
+	});
+
+	/** Loads and decodes a picture off screen, so the image that takes it next draws it in the same frame. Never rejects. */
+	function decodedImage(url: string): Promise<void> {
+		const image = new Image();
+		const crossOrigin = plateImageCrossOrigin(url);
+		if (crossOrigin) image.crossOrigin = crossOrigin;
+		image.src = url;
+		return image.decode().catch(() => undefined);
+	}
 </script>
 
