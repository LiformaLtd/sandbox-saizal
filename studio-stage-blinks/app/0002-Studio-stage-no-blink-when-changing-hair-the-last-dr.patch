 							const img = event.currentTarget as HTMLImageElement;
@@ -662,6 +715,10 @@
 				{/key}
 				{#if sizedEyesUrl}{@render eyesImg()}{/if}
 			{/if}
+			<!-- The look last drawn, kept loaded out of sight; shown on top while a new look is not drawn yet (which is hidden meanwhile). -->
+			{#each drawnLook as src (src)}
+				<img class="preview-avatar preview-avatar-held" {src} alt="" />
+			{/each}
 			</div>
 		</div>
 	{/if}
@@ -969,7 +1026,8 @@
 
 	.preview-avatar-clothes,
 	.preview-avatar-eyes,
-	.preview-avatar-hair {
+	.preview-avatar-hair,
