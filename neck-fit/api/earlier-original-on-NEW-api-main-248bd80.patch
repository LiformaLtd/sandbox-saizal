+++ b/src/lib/server/catalog/neckFitJaw.ts
@@ -0,0 +1,297 @@
+// LOCAL DEV ONLY (2026-10-28): where a face's jaw ends, for the neck fit (neckFit.ts): the dark line under a jaw, a
+// face's chin line, and lining one face up with another.
+
+import type { FaceOutline } from './ethnicityPlateMaker';
+
+export type Rgba = ArrayLike<number>;
+export type Point = [number, number];
+
+const W = 1024;
+const N = W * W;
+
+/** px outwards the dark line under a jaw is looked for (RIM_REACH for a seed's jaw) */
+const CUT_REACH = 6;
+const RIM_REACH = 10;
+/** a seed's jaw: how wide a rim of light under a dark chin can be, and how close to the dark point it falls back */
+const RIM_WIDTH = 4;
+const RIM_BACK = 8;
+/** a seed's jaw that never brightens within reach: the first point within SEED_NEAR of the darkest, if that is
+ *  SEED_DARKER darker than at the dots */
+const SEED_NEAR = 5;
+const SEED_DARKER = 15;
+/** an avatar's cut: a short stretch more than NOTCH px off the median of the 25 points round it is put back on it */
+const NOTCH = 1.5;
+/** brighter than the darkest point by this much = the neck has started */
+const CUT_RISE = 22;
+/** px along the jaw over which the cut eases from the cheek edge onto the dark line */
+const CORNER_EASE = 8;
+/** face edges are lined up over this box, shifts up to FACE_SHIFT px */
+const FACE_BOX = { x0: 440, x1: 584, y0: 250, y1: 362 };
+const FACE_SHIFT = 6;
+
+/** The lower half of the face outline: under one ear, round the chin, to under the other. */
+const JAW_OUTLINE = [132, 58, 172, 136, 150, 149, 176, 148, 152, 377, 400, 378, 379, 365, 397, 288, 361];
+/** The chin line used for the neck colour change (flat past either end). */
+const CHIN = [136, 150, 149, 176, 148, 152, 377, 400, 378, 379, 365];
+
+export const lum = (p: Rgba, k: number) => 0.299 * p[k] + 0.587 * p[k + 1] + 0.114 * p[k + 2];
+
+function dot(o: FaceOutline, i: number): Point {
+	const k = W / o.width;
+	return [o.dots478[i][0] * k, o.dots478[i][1] * k];
+}
+
+/** A face's chin line per column, flat past either end. */
+export function chinLine(o: FaceOutline): Float32Array {
+	const P = CHIN.map((i) => dot(o, i));
+	return Float32Array.from({ length: W }, (_, x) => {
+		const t = x + 0.5;
+		if (t <= P[0][0]) return P[0][1];
+		if (t >= P[P.length - 1][0]) return P[P.length - 1][1];
+		for (let j = 1; j < P.length; j++) {
+			if (t <= P[j][0]) return P[j - 1][1] + ((P[j][1] - P[j - 1][1]) * (t - P[j - 1][0])) / (P[j][0] - P[j - 1][0]);
+		}
+		return P[P.length - 1][1];
+	});
+}
+
+/** Where a head ends: the dark line under its jaw. */
+export type JawCut = {
+	/** how much of each pixel is above the cut (the cut drawn as one smooth shape, 4 lines per pixel) */
+	readonly mask: Float32Array;
+	/** the cut, one point per px along the jaw outline */
+	readonly cut: readonly Point[];
+	/** where each cut point sits along the outline dots (0..16), so two faces' cuts can be matched */
+	readonly par: readonly number[];
+	/** unit direction along the jaw at each point (outwards = [-ty, tx]) */
+	readonly normals: readonly Point[];
+	/** the jaw corners (dots 172 and 397) as cut indices */
+	readonly from: number;
+	readonly to: number;
+};
+
+/**
+ * The dark line under a face's jaw, found in `head` (the picture that has that face). At every pixel along the jaw
+ * outline between the jaw corners the picture is read outwards across the jaw edge, averaged over 5 px along the jaw:
+ * the cut is the darkest point before it brightens into the neck (or within 2 px of where it turns see-through). Up the
+ * cheek sides the cut is left well outside, so the head keeps its own edge there.
+ * `seed`: a seed's jaw on its white tee - looks further out, and past a rim of light on a dark chin's underside.
+ * `steady` (a head's cut): a short stretch where the search jumped (a dark patch inside a beard read as the jaw shadow) is
+ * put back, and the cut is averaged along the jaw.
+ */
+export function jawCut(o: FaceOutline, head: Rgba, opts: { seed?: boolean; steady?: boolean } = {}): JawCut {
+	const P = JAW_OUTLINE.map((i) => dot(o, i));
+	const pts: Point[] = [];
+	const at = [0];
+	const par: number[] = [];
+	for (let j = 1; j < P.length; j++) {
+		const [x0, y0] = P[j - 1];
+		const [x1, y1] = P[j];
+		const n = Math.max(1, Math.ceil(Math.hypot(x1 - x0, y1 - y0)));
+		for (let t = 0; t < n; t++) {
+			pts.push([x0 + ((x1 - x0) * t) / n, y0 + ((y1 - y0) * t) / n]);
+			par.push(j - 1 + t / n);
+		}
+		at.push(pts.length);
+	}
+	pts.push(P[P.length - 1]);
+	par.push(P.length - 1);
+	const from = at[JAW_OUTLINE.indexOf(172)];
+	const to = at[JAW_OUTLINE.indexOf(397)];
+	const read = (x: number, y: number): [number, number] => {
+		const x0 = Math.floor(x - 0.5);
+		const y0 = Math.floor(y - 0.5);
+		const fx = x - 0.5 - x0;
+		const fy = y - 0.5 - y0;
+		let l = 0;
+		let a = 0;
+		for (const [dx, dy, w] of [
+			[0, 0, (1 - fx) * (1 - fy)],
+			[1, 0, fx * (1 - fy)],
+			[0, 1, (1 - fx) * fy],
+			[1, 1, fx * fy]
+		]) {
+			const kk = ((y0 + dy) * W + x0 + dx) * 4;
+			l += w * lum(head, kk);
+			a += w * head[kk + 3];
+		}
+		return [l, a / 255];
+	};
+	const normals: Point[] = pts.map((_, i) => {
+		const a = pts[Math.max(0, i - 2)];
+		const b = pts[Math.min(pts.length - 1, i + 2)];
+		const l = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
+		return [(b[0] - a[0]) / l, (b[1] - a[1]) / l];
+	});
+	const off = pts.map((p, i) => {
+		if (i < from || i > to) return CUT_REACH;
+		const [tx, ty] = normals[i];
+		const nx = -ty;
+		const ny = tx;
+		const ds: number[] = [];
+		const ss: number[] = [];
+		let edge: number | null = null;
+		for (let d = -4; d <= (opts.seed ? RIM_REACH : CUT_REACH); d += 0.5) {
+			if (read(p[0] + nx * d, p[1] + ny * d)[1] < 0.8) {
+				edge = d;
+				break;
+			}
+			let s = 0;
+			let n = 0;
+			for (let t = -2; t <= 2; t++) {
+				const [l, a] = read(p[0] + nx * d + tx * t, p[1] + ny * d + ty * t);
+				if (a >= 0.8) {
+					s += l;
+					n++;
+				}
+			}
+			ds.push(d);
+			ss.push(s / n);
+		}
+		// the darkest point before it brightens by CUT_RISE, from sample `start` on: [dark point, rise] (−1 = none)
+		const darkest = (start: number): [number, number] => {
+			let lo = Infinity;
+			let atDark = -1;
+			for (let j = start; j < ss.length; j++) {
+				if (ss[j] < lo) {
+					lo = ss[j];
+					atDark = j;
+				} else if (ss[j] > lo + CUT_RISE) return [atDark, j];
+			}
+			return [atDark, -1];
+		};
+		let [atDark, rise] = darkest(0);
+		let rim = false;
+		// a seed's dark chin can have a rim of light on its underside: when the brightening falls back to the dark
+		// point's level within RIM_WIDTH px, the edge is past the rim
+		while (opts.seed && rise >= 0) {
+			let back = -1;
+			for (let j = rise + 1; j < ss.length && ds[j] <= ds[rise] + RIM_WIDTH; j++) {
+				if (ss[j] <= ss[atDark] + RIM_BACK) {
+					back = j;
+					break;
+				}
+			}
+			if (back < 0) break;
+			[atDark, rise] = darkest(back);
+			rim = true;
+		}
+		const dark = atDark >= 0 ? ds[atDark] : null;
+		if (rise >= 0) return dark as number; // it brightened into the neck before any see-through edge
+		if (edge !== null) return dark === null ? edge - 0.5 : Math.max(dark, edge - 2);
+		if (rim) return dark as number;
+		if (opts.seed && atDark >= 0) {
+			// never brightens within reach: the first point about as dark as the darkest, if clearly darker than at the dots
+			const first = ss.findIndex((v, j) => j <= atDark && v <= ss[atDark] + SEED_NEAR);
+			const atDots = ds.findIndex((d) => d >= 0);
+			if (atDots >= 0 && ss[atDots] - ss[atDark] > SEED_DARKER) return ds[first];
+		}
+		return 0.5; // never brightens: 1 px under the dots
+	});
+	for (let i = Math.max(0, from - CORNER_EASE); i < from; i++)
+		off[i] = off[from] + ((CUT_REACH - off[from]) * (from - i)) / CORNER_EASE;
+	for (let i = to + 1; i <= Math.min(pts.length - 1, to + CORNER_EASE); i++)
+		off[i] = off[to] + ((CUT_REACH - off[to]) * (i - to)) / CORNER_EASE;
+	if (opts.steady) {
+		const med = off.map((_, i) => {
+			const v = off.slice(Math.max(0, i - 12), i + 13).sort((p, q) => p - q);
+			return v[v.length >> 1];
+		});
+		for (let i = 0; i < off.length; i++) if (Math.abs(off[i] - med[i]) > NOTCH) off[i] = med[i];
+	}
+	let sm = off.map((_, i) => {
+		const v = off.slice(Math.max(0, i - 4), i + 5).sort((p, q) => p - q);
+		return v[v.length >> 1];
+	});
+	// a head's cut is then averaged over 11 points, so its edge follows the jaw without 1 px bumps
+	if (opts.steady) {
+		sm = sm.map((_, i) => {
+			let s = 0;
+			let n = 0;
+			for (let j = Math.max(0, i - 5); j <= Math.min(sm.length - 1, i + 5); j++) {
+				s += sm[j];
+				n++;
+			}
+			return s / n;
+		});
+	}
+	const cut: Point[] = pts.map((p, i) => [p[0] - normals[i][1] * (sm[i] + 0.5), p[1] + normals[i][0] * (sm[i] + 0.5)]);
+	// the kept shape: above the cut, and past either end of the jaw above a steep line out to the sides (ears never cut)
+	const first = cut[0];
+	const last = cut[cut.length - 1];
+	const E0: Point = [first[0] - 60, first[1] + 180];
+	const E1: Point = [last[0] + 60, last[1] + 180];
+	const poly: Point[] = [[-10, -10], [-10, E0[1]], E0, ...cut, E1, [W + 10, E1[1]], [W + 10, -10]];
+	const top = Math.max(0, Math.floor(Math.min(...cut.map((q) => q[1]))) - 1);
+	const bottom = Math.min(W, Math.ceil(Math.max(E0[1], E1[1])) + 1);
+	const mask = new Float32Array(N);
+	mask.fill(1, 0, top * W);
+	for (let y = top; y < bottom; y++) {
+		for (let sub = 0; sub < 4; sub++) {
+			const ys = y + (sub + 0.5) / 4;
+			const hits: [number, number][] = [];
+			for (let j = 0; j < poly.length; j++) {
+				const [ax, ay] = poly[j];
+				const [bx, by] = poly[(j + 1) % poly.length];
+				if ((ay <= ys && ys < by) || (by <= ys && ys < ay))
+					hits.push([ax + ((ys - ay) * (bx - ax)) / (by - ay), by > ay ? 1 : -1]);
+			}
+			hits.sort((p, q) => p[0] - q[0]);
+			let wind = 0;
+			for (let h = 0; h < hits.length - 1; h++) {
+				wind += hits[h][1];
+				if (!wind) continue;
+				const xa = Math.max(0, hits[h][0]);
+				const xb = Math.min(W, hits[h + 1][0]);
+				for (let x = Math.floor(xa); x < xb; x++) mask[y * W + x] += (Math.min(xb, x + 1) - Math.max(xa, x)) / 4;
+			}
+		}
+	}
+	return { mask, cut, par, normals, from, to };
+}
+
+/** A face's edges (how fast the brightness changes) round the nose, mouth and chin, for lining faces up. */
+export function faceEdges(P: Rgba): Float32Array {
+	const g = new Float32Array(N);
+	const { x0, x1, y0, y1 } = FACE_BOX;
+	for (let y = y0 - FACE_SHIFT - 1; y < y1 + FACE_SHIFT + 1; y++) {
+		for (let x = x0 - FACE_SHIFT - 1; x < x1 + FACE_SHIFT + 1; x++) {
+			const k = (y * W + x) * 4;
+			if (P[k + 3] < 200) continue;
+			g[y * W + x] = Math.hypot(lum(P, k + 4) - lum(P, k - 4), lum(P, k + W * 4) - lum(P, k - W * 4));
+		}
+	}
+	return g;
+}
+
+/** The shift (up to FACE_SHIFT px) that best lines `edges` up with `ref`, and how well (correlation, −1..1). */
+export function alignFace(edges: Float32Array, ref: Float32Array): { dx: number; dy: number; score: number } {
+	const { x0, x1, y0, y1 } = FACE_BOX;
+	let best = { dx: 0, dy: 0, score: -2 };
+	for (let dy = -FACE_SHIFT; dy <= FACE_SHIFT; dy++) {
+		for (let dx = -FACE_SHIFT; dx <= FACE_SHIFT; dx++) {
+			let sa = 0;
+			let sb = 0;
+			let sab = 0;
+			let saa = 0;
+			let sbb = 0;
+			let n = 0;
+			for (let y = y0; y < y1; y++) {
+				for (let x = x0; x < x1; x++) {
+					const a = ref[y * W + x];
+					const b = edges[(y + dy) * W + x + dx];
+					sa += a;
+					sb += b;
+					sab += a * b;
+					saa += a * a;
+					sbb += b * b;
+					n++;
+				}
+			}
+			const cov = sab / n - (sa / n) * (sb / n);
+			const score = cov / Math.sqrt((saa / n - (sa / n) ** 2) * (sbb / n - (sb / n) ** 2) + 1e-9);
+			if (score > best.score) best = { dx, dy, score };
+		}
+	}
+	return best;
+}
diff --git a/src/routes/internal/avatar-sets/[avatarSetId]/fitted-plate/+server.ts b/src/routes/internal/avatar-sets/[avatarSetId]/fitted-plate/+server.ts
new file mode 100644
index 0000000..ec3410d
--- /dev/null
+++ b/src/routes/internal/avatar-sets/[avatarSetId]/fitted-plate/+server.ts
@@ -0,0 +1,71 @@
+// LOCAL DEV ONLY (2026-10-28): an ethnicity outfit plate made here on the server, for the Studio's preview - the same
+// bake a character save runs (bakePlatePng: the neck fit when its inputs are there), so the browser does no blending
+// and the preview is the saved picture. ?outfit=<catalogue clothes id>&race=<ethnicity>&size=256|512|1024&format=webp|png
+import sharp from 'sharp';
+
+import { AuthoringError, authoringErrorJson } from '$lib/server/authoring/authoringHttp';
+import { isAvatarSetMakerInputName, loadMakerFileGender } from '$lib/server/catalog/avatarSetMakerInput';
+import { loadAvatarSetById } from '$lib/server/catalog/avatarSets';
+import { bakePlatePng } from '$lib/server/catalog/resolveOrBakeAvatarSetClothes';
+import { requestIdFromLocals } from '$lib/server/http/structuredApiError';
+import { requirePortalContext } from '$lib/server/platform/portalContext';
+
+import type { RequestHandler } from './$types';
+
+const SIZES = [256, 512, 1024] as const;
+const FORMATS = { webp: 'image/webp', png: 'image/png' } as const;
+/** Plates made here lately, kept for this process: switching back to an outfit or ethnicity answers at once. */
+const KEEP = 240;
+const made = new Map<string, Promise<Uint8Array<ArrayBuffer>>>();
+
+function remember(key: string, make: () => Promise<Uint8Array<ArrayBuffer>>): Promise<Uint8Array<ArrayBuffer>> {
+	let hit = made.get(key);
+	if (hit) {
+		made.delete(key);
+	} else {
+		hit = make();
+		hit.catch(() => made.delete(key));
+	}
+	made.set(key, hit);
+	while (made.size > KEEP) made.delete(made.keys().next().value as string);
+	return hit;
+}
+
+export const GET: RequestHandler = async (event) => {
+	const requestId = requestIdFromLocals(event.locals);
+	const portal = await requirePortalContext(event.request.headers.get('authorization'));
+	const avatarSetId = event.params.avatarSetId?.trim() ?? '';
+	const outfit = event.url.searchParams.get('outfit') ?? '';
+	const race = event.url.searchParams.get('race') ?? '';
+	const size = Number(event.url.searchParams.get('size') ?? 1024);
+	const format = (event.url.searchParams.get('format') ?? 'webp') as keyof typeof FORMATS;
+	if (
+		!outfit ||
+		!race ||
+		!isAvatarSetMakerInputName(outfit) ||
+		!isAvatarSetMakerInputName(race) ||
+		!(SIZES as readonly number[]).includes(size) ||
+		!(format in FORMATS)
+	) {
+		return authoringErrorJson(new AuthoringError(400, 'INVALID_BODY', 'Bad plate request.'), requestId);
+	}
+	try {
+		const bytes = await remember(`${avatarSetId}:${outfit}:${race}:${size}:${format}`, async () => {
+			const set = await loadAvatarSetById(portal.prisma, avatarSetId);
+			const member = set?.members.find((m) => m.ethnicity === race);
+			if (!set || !member) throw new AuthoringError(404, 'UNKNOWN_INPUT', 'No such plate.');
+			if (!set.clothesIds.includes(outfit)) throw new AuthoringError(404, 'UNKNOWN_INPUT', 'No such plate.');
+			const makerGender = await loadMakerFileGender(portal.prisma, member.avatarId);
+			const png = await bakePlatePng({ set, clothesId: outfit, ethnicity: race, makerGender });
+			const resized = sharp(png).resize(size, size, { kernel: 'lanczos3' });
+			const out = format === 'png' ? resized.png() : resized.webp({ quality: 92 });
+			return new Uint8Array(await out.toBuffer()) as Uint8Array<ArrayBuffer>;
+		});
+		return new Response(bytes, {
+			headers: { 'content-type': FORMATS[format], 'cache-control': 'private, max-age=86400' }
+		});
+	} catch (error) {
+		if (error instanceof AuthoringError) return authoringErrorJson(error, requestId);
+		throw error;
+	}
+};
