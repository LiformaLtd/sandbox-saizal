+import { describe, expect, it } from 'vitest';
+
+import type { FaceOutline } from './ethnicityPlateMaker';
+import { outfitJaws, prepareFitAvatar, prepareFitSeeds, stackFitPlate } from './neckFit';
+import { jawCut } from './neckFitJaw';
+
+const W = 1024;
+const N = W * W;
+
+/** The face-outline dots the fit reads, on an ellipse round (512, 300) (every other dot at 0, 0). */
+function outline(rx: number, ry: number): FaceOutline {
+	const dots: number[][] = Array.from({ length: 478 }, () => [0, 0, 0]);
+	// lower half of the face, under one ear round the chin to under the other, in picture order (left to right)
+	const jaw = [132, 58, 172, 136, 150, 149, 176, 148, 152, 377, 400, 378, 379, 365, 397, 288, 361];
+	jaw.forEach((id, j) => {
+		const a = Math.PI - (Math.PI * j) / (jaw.length - 1);
+		dots[id] = [512 + rx * Math.cos(a), 300 + ry * Math.sin(a), 0];
+	});
+	return { width: W, dots478: dots };
+}
+
+const inEllipse = (x: number, y: number, rx: number, ry: number) =>
+	((x + 0.5 - 512) / rx) ** 2 + ((y + 0.5 - 300) / ry) ** 2 <= 1;
+
+/** A bald head (face ellipse rx × ry), a 2 px shadow line under its chin, its neck, and below row `wearFrom` `wear`. */
+function person(
+	rx: number,
+	ry: number,
+	face: number[],
+	neck: number[],
+	wear: number[],
+	wearFrom: number
+): Uint8ClampedArray {
+	const out = new Uint8ClampedArray(N * 4);
+	for (let y = 150; y < 600; y++) {
+		for (let x = 380; x < 644; x++) {
+			const k = (y * W + x) * 4;
+			let rgb: number[] | null = null;
+			if (y >= wearFrom) rgb = wear;
+			else if (inEllipse(x, y, rx, ry)) rgb = face;
+			else if (inEllipse(x, y, rx + 2, ry + 2) && y > 300) rgb = [40, 28, 24];
+			else if (x >= 462 && x < 562 && y > 300) rgb = neck;
+			if (rgb) out.set([...rgb, 255], k);
+		}
+	}
+	return out;
+}
+
+const NAVY = [20, 30, 60];
+const TEE = [235, 235, 235];
+const MIX: [number, number, number] = [0.5, 0.5, 0.5];
+
+/** Seeds with chins at row 378 (ry 78); the avatar's chin at row 370 (ry 70), 8 px higher. */
+function scene() {
+	const lightFace = [230, 190, 160];
+	const darkFace = [110, 70, 50];
+	const lightNeck = [210, 170, 140];
+	const darkNeck = [100, 64, 46];
+	const base = person(90, 78, lightFace, lightNeck, TEE, 460);
+	const baseDark = person(90, 78, darkFace, darkNeck, TEE, 460);
+	const light = person(90, 78, lightFace, lightNeck, NAVY, 420);
+	const dark = person(90, 78, darkFace, darkNeck, NAVY, 420);
+	const avatarFace = [200, 140, 100];
+	const avatarNeck = [180, 120, 86];
+	const own = person(90, 70, avatarFace, avatarNeck, TEE, 460);
+	const head = person(90, 70, avatarFace, avatarNeck, [0, 0, 0], 600);
+	const headShape = new Uint8ClampedArray(N * 4);
+	for (let y = 0; y < W; y++) {
+		for (let x = 0; x < W; x++) {
+			const oldHead = inEllipse(x, y, 91, 79) && y < 382;
+			headShape.set([y >= 292 && y < 382 ? 255 : 0, y < 382 ? 255 : 0, oldHead ? 255 : 0, 255], (y * W + x) * 4);
+		}
+	}
+	const seeds = prepareFitSeeds(outline(88, 76), outline(88, 76), base, baseDark);
+	const avatar = prepareFitAvatar({
+		head,
+		outline: outline(88, 68),
+		own,
+		base,
+		baseDark,
+		headShape,
+		seeds,
+		lightOutline: outline(88, 76),
+		darkOutline: outline(88, 76),
+		mix: MIX
+	});
+	return { light, dark, headShape, seeds, avatar, avatarFace };
+}
+
+const at = (rgba: ArrayLike<number>, x: number, y: number) => {
+	const k = (y * W + x) * 4;
+	return [rgba[k], rgba[k + 1], rgba[k + 2], rgba[k + 3]];
+};
+
+describe('jawCut', () => {
+	it('cuts a head at the dark line under its chin', () => {
+		const head = person(90, 70, [200, 140, 100], [180, 120, 86], TEE, 460);
+		const cut = jawCut(outline(88, 68), head);
+		const chin = cut.cut.reduce((p, q) => (Math.abs(q[0] - 512) < Math.abs(p[0] - 512) ? q : p));
+		expect(chin[1]).toBeGreaterThan(369.5);
+		expect(chin[1]).toBeLessThan(373);
+	});
+});
+
+describe('stackFitPlate', () => {
+	it("moves the outfit's own neck up to a higher jaw, so no part of the old face shows", () => {
+		const s = scene();
+		const out = stackFitPlate(
+			s.light,
+			s.dark,
+			s.headShape,
+			{ line: [], keep: [] },
+			MIX,
+			s.avatar,
+			outfitJaws(s.light, s.dark, s.seeds)
+		);
+		// the head is the avatar's
+		expect(at(out, 512, 330).slice(0, 3)).toEqual(s.avatarFace);
+		// right under its chin (row 370) nothing is see-through and nothing is the seeds' mixed face colour
+		const seedFace = [170, 130, 105];
+		for (let y = 372; y < 380; y++) {
+			const p = at(out, 512, y);
+			expect(p[3]).toBe(255);
+			expect(
+				Math.abs(p[0] - seedFace[0]) + Math.abs(p[1] - seedFace[1]) + Math.abs(p[2] - seedFace[2])
+			).toBeGreaterThan(20);
+		}
+		// the collar is where it was
+		expect(at(out, 512, 440)).toEqual([...NAVY, 255]);
+	});
+});
