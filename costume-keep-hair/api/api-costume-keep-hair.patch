@@ -0,0 +1,86 @@
+import { describe, expect, it } from 'vitest';
+import { makeRacePlate, PLATE_SIZE, type PreparedFace } from './ethnicityPlateMaker';
+
+const SIZE = PLATE_SIZE;
+const N = SIZE * SIZE;
+
+function solid(r: number, g: number, b: number, a = 255): Uint8Array {
+	const rgba = new Uint8Array(N * 4);
+	for (let i = 0; i < N; i++) {
+		rgba[i * 4] = r;
+		rgba[i * 4 + 1] = g;
+		rgba[i * 4 + 2] = b;
+		rgba[i * 4 + 3] = a;
+	}
+	return rgba;
+}
+
+/** A clear face above the chin, so the join is in the punch-out region, plus one opaque face pixel. */
+function clearFace(): PreparedFace {
+	const rgb = new Uint8Array(N * 3);
+	const alpha = new Uint8Array(N);
+	rgb[0] = 0;
+	rgb[1] = 255;
+	rgb[2] = 0;
+	const covered = 20 * SIZE + 20;
+	rgb[covered * 3] = 0;
+	rgb[covered * 3 + 1] = 0;
+	rgb[covered * 3 + 2] = 255;
+	alpha[covered] = 255;
+	return { rgb, alpha, below: new Float64Array(N).fill(-10) };
+}
+
+describe('whole costume face join', () => {
+	const costume = solid(200, 40, 40);
+	const face = clearFace();
+	const mix = { values: [0, 0, 0] as [number, number, number] };
+
+	it('punches a clear face pixel out of a clothes plate', () => {
+		const { rgba } = makeRacePlate(costume, costume, costume, face, mix, undefined);
+		expect(rgba[3]).toBe(0);
+	});
+
+	it('lets the costume plate show through a clear face pixel', () => {
+		const { rgba } = makeRacePlate(costume, costume, costume, face, mix, { wholeCostume: true });
+		expect([rgba[0], rgba[1], rgba[2], rgba[3]]).toEqual([200, 40, 40, 255]);
+	});
+
+	it('still paints an opaque face pixel onto a whole costume', () => {
+		const { rgba } = makeRacePlate(costume, costume, costume, face, mix, { wholeCostume: true });
+		const i = (20 * SIZE + 20) * 4;
+		expect([rgba[i], rgba[i + 1], rgba[i + 2], rgba[i + 3]]).toEqual([0, 0, 255, 255]);
+	});
+
+	// The face plate is a bald head: it must not cover the hair or headwear the costume was drawn with.
+	describe('hair and headwear', () => {
+		const HAIR = [30, 20, 10] as const;
+		const bald = solid(220, 180, 150);
+		/** The bald plate with a block of hair, rows and columns 30-89. */
+		const withHair = solid(220, 180, 150);
+		for (let y = 30; y < 90; y++) {
+			for (let x = 30; x < 90; x++) withHair.set(HAIR, (y * SIZE + x) * 4);
+		}
+		/** An opaque blue head over rows and columns 20-99: the hair block and the skin round it. */
+		const head: PreparedFace = { rgb: new Uint8Array(N * 3), alpha: new Uint8Array(N), below: new Float64Array(N).fill(-10) };
+		for (let y = 20; y < 100; y++) {
+			for (let x = 20; x < 100; x++) {
+				head.rgb[(y * SIZE + x) * 3 + 2] = 255;
+				head.alpha[y * SIZE + x] = 255;
+			}
+		}
+		const made = makeRacePlate(withHair, withHair, bald, head, mix, { wholeCostume: true });
+		const at = (y: number, x: number) => Array.from(made.rgba.slice((y * SIZE + x) * 4, (y * SIZE + x) * 4 + 4));
+
+		it('keeps the costume hair on top of the face plate', () => {
+			expect(at(60, 60)).toEqual([...HAIR, 255]);
+		});
+
+		it('paints the face where the costume is bald', () => {
+			expect(at(25, 25)).toEqual([0, 0, 255, 255]);
+		});
+
+		it('does not count the hair as a wrong face pixel', () => {
+			expect(made.report.faceExactAbove340).toBe(0);
+		});
+	});
+});
