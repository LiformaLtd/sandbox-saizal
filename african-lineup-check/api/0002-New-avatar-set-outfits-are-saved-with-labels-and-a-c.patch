@@ -0,0 +1,111 @@
+/**
+ * Labels for a new avatar-set outfit when the Studio saves it (the two-step race outfits of raceOutfitSteps.ts).
+ * The Studio sends only the picture and a name made from the words the author typed.
+ *
+ * - The European picture is read like a Studio "+ New clothes" picture: one AI read of the name, one of the picture,
+ *   merged. Its labels, description and country are saved with the row.
+ * - The African picture and every race plate of that outfit copy the European row's labels.
+ * - The name loses any franchise, character or brand name the word list knows.
+ *
+ * A failed read is logged (`clothes.labels failed`) and the outfit is still saved, without those labels.
+ */
+import type { PrismaClient } from '@prisma/client';
+
+import type { CreateWardrobeInput } from '$lib/server/authoring/createLibraryAssets';
+import { getR2ObjectBuffer, privateAuthoringBucket } from '$lib/server/authoring/r2';
+import { classifyClothesVision, inferClothesPromptIntent, logLabelsFailed } from '$lib/server/clothesGeneration/classifiers';
+import { visionClassifierRendition } from '$lib/server/clothesGeneration/compositeRgba';
+import { EMPTY_CLOTHES_LABELS, reconcileClothesLabels } from '$lib/server/clothesGeneration/labels';
+import { outfitWordsWithoutNames } from '$lib/server/clothesGeneration/outfitPromptCheck';
+import { loadClothesTaxonomyMap, loadCostumeTaxonomyMap } from '$lib/server/taxonomy/wardrobeTaxonomyPersist';
+import { customOutfitSeedAuthoringKey, parseCustomOutfitSeedExternalId } from './customOutfitSeed';
+
+/** The longest wait for one AI read; the save does not wait longer for labels. */
+const READ_TIMEOUT_MS = 10_000;
+/** A race plate of an outfit kept from the browser: `avatar-set-outfit:{avatarId}:{outfit}--{race}`. */
+const RACE_PLATE = /^avatar-set-outfit:[^:]+:(.+?)--[a-z-]+$/;
+
+type Labels = Pick<CreateWardrobeInput, 'taxonomy' | 'description' | 'country'>;
+
+export async function withSetOutfitLabels(prisma: PrismaClient, input: CreateWardrobeInput): Promise<CreateWardrobeInput> {
+	if (input.kind === 'hair' || !input.externalId) return input;
+	const seed = parseCustomOutfitSeedExternalId(input.externalId);
+	const racePlateOf = seed ? null : (RACE_PLATE.exec(input.externalId)?.[1] ?? null);
+	if (!seed && !racePlateOf) return input;
+
+	const named = { ...input, ...(input.name ? { name: cleanName(input.name, input.externalId) } : {}) };
+	// A caller that already has labels keeps them.
+	if (input.taxonomy) return named;
+	try {
+		if (seed?.ethnicity === 'european') {
+			const png = await getR2ObjectBuffer(privateAuthoringBucket(), customOutfitSeedAuthoringKey(input.projectId, seed));
+			return { ...named, ...(await labelsFromPicture(png, named.name ?? '', input.avatarId)) };
+		}
+		const copied = await europeanLabels(prisma, input, seed ? null : racePlateOf);
+		// A race plate with no new-outfit row behind it is a catalogue outfit: not labelled here.
+		if (!copied && seed) logLabelsFailed('copy', 'the European picture of this outfit has no saved row', input.externalId);
+		return copied ? { ...named, ...copied } : named;
+	} catch (error) {
+		logLabelsFailed(seed?.ethnicity === 'european' ? 'picture' : 'copy', error, input.externalId);
+		return named;
+	}
+}
+
+/** The name without franchise, character or brand names, starting with a capital. */
+function cleanName(name: string, externalId: string): string {
+	const cleaned = outfitWordsWithoutNames(name);
+	if (cleaned.removed.length === 0) return name;
+	const words = cleaned.words.charAt(0).toUpperCase() + cleaned.words.slice(1);
+	console.info('clothes.labels name cleaned', { externalId, from: name, to: words, removed: cleaned.removed });
+	return words;
+}
+
+async function labelsFromPicture(png: Buffer, name: string, avatarId: string): Promise<Labels> {
+	const rendition = await visionClassifierRendition(png);
+	const [intent, visual] = await Promise.all([
+		withinLimit('words', inferClothesPromptIntent({ rawPrompt: name, avatarId, userOverrides: null, userOverrideDimensions: [] })),
+		withinLimit('picture', classifyClothesVision({ imagePngBase64: rendition.toString('base64') }))
+	]);
+	const labels = reconcileClothesLabels({
+		userOverrides: null,
+		userOverrideDimensions: [],
+		promptIntent: intent?.labels ?? EMPTY_CLOTHES_LABELS,
+		visual
+	});
+	return { taxonomy: { ...labels.taxonomy }, description: labels.description, country: labels.country };
+}
+
+function withinLimit<T>(read: 'words' | 'picture', work: Promise<T | null>): Promise<T | null> {
+	let timer: ReturnType<typeof setTimeout> | undefined;
+	const limit = new Promise<null>((resolve) => {
+		timer = setTimeout(() => {
+			logLabelsFailed(read, `no answer in ${READ_TIMEOUT_MS / 1000} s`);
+			resolve(null);
+		}, READ_TIMEOUT_MS);
+	});
+	return Promise.race([work, limit]).finally(() => clearTimeout(timer));
+}
+
+/** The labels saved with the European picture of the same outfit: `racePlateOf` names it for a race plate. */
+async function europeanLabels(
+	prisma: PrismaClient,
+	input: CreateWardrobeInput,
+	racePlateOf: string | null
+): Promise<Labels | null> {
+	const where = {
+		projectId: input.projectId,
+		deletedAt: null,
+		externalId: racePlateOf
+			? { startsWith: 'avatar-set-', contains: '-seed:', endsWith: `:${racePlateOf}:european` }
+			: input.externalId!.replace(/:african$/, ':european')
+	};
+	const select = { id: true, description: true, country: true } as const;
+	const row =
+		input.kind === 'costume'
+			? await prisma.costume.findFirst({ where, select })
+			: await prisma.clothes.findFirst({ where, select });
+	if (!row) return null;
+	const load = input.kind === 'costume' ? loadCostumeTaxonomyMap : loadClothesTaxonomyMap;
+	const taxonomy = (await load(prisma, [row.id])).get(row.id);
+	return { taxonomy: taxonomy ? { ...taxonomy } : null, description: row.description, country: row.country };
+}
