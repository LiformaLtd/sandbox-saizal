 	let contactClothesUrl = $state('');
 	let contactHairUrl = $state('');
@@ -261,7 +264,44 @@
 		avatarReady
 	});
 	const sceneRevealed = $derived(studioPreviewSceneRevealed(revealInput));
-	const subjectRevealed = $derived(studioPreviewSubjectRevealed(revealInput));
+	/** The look asked for is drawn. */
+	const lookDrawn = $derived(studioPreviewSubjectRevealed(revealInput));
+	/**
+	 * The look the stage last drew in full (picture sources, bottom to top). When the stage changes how it draws the character
+	 * (one picture <-> clothes + hair layers: a first hair, Bald, another face), this look stays on top until the new one is
+	 * drawn, instead of the character fading out and back in; at most PAIR_HOLD_MS (2026-10-22).
+	 */
+	let drawnLook = $state<string[]>([]);
+	let lookHoldTimedOut = $state(false);
+	const waitingForLook = $derived(!lookDrawn && drawnLook.length > 0 && Boolean(layered || avatarImage));
+	const holdingLook = $derived(waitingForLook && !lookHoldTimedOut);
+	const subjectRevealed = $derived(lookDrawn || holdingLook);
+	/** The pictures on screen now, only when each is known to be drawn (null while any is still loading). */
+	const drawnNow = $derived.by((): string[] | null => {
+		if (layered && sizedClothesUrl) {
+			if (holdingPair && shownPair) return [shownPair.clothes, shownPair.hair];
+			if (clothesReadyFor !== sizedClothesUrl) return null;
+			if (sizedHairUrl && hairReadyFor !== sizedHairUrl) return null;
+			return [displayClothesUrl, ...(sizedHairUrl ? [displayHairUrl] : [])];
+		}
+		return sizedAvatarImage && avatarDrawnFor === sizedAvatarImage ? [sizedAvatarImage] : null;
+	});
+	$effect(() => {
+		if (!layered && !avatarImage) {
+			drawnLook = [];
+			return;
+		}
+		const now = drawnNow;
+		if (now && now.join('|') !== untrack(() => drawnLook).join('|')) drawnLook = now;
+	});
+	$effect(() => {
+		if (!waitingForLook) {
+			lookHoldTimedOut = false;
+			return;
+		}
+		const timer = setTimeout(() => (lookHoldTimedOut = true), PAIR_HOLD_MS);
+		return () => clearTimeout(timer);
+	});
 
 	$effect(() => {
 		void displayBackground;
@@ -291,7 +331,10 @@
 			return;
 		}
 		let cancelled = false;
-		void hairContactPlates(clothes, hair).then((plates) => {
+		void hairContactPlates(clothes, hair).then(async (plates) => {
+			if (cancelled) return;
+			// Decode both before they replace the pair on screen: a swapped-in picture still decoding paints as a blink.
+			await Promise.all([decodedImage(plates.clothesUrl ?? clothes), decodedImage(plates.hairUrl ?? hair)]);
 			if (cancelled) return;
 			contactClothesUrl = plates.clothesUrl ?? '';
 			contactHairUrl = plates.hairUrl ?? '';
@@ -447,6 +490,13 @@
 		return (element) => attachImageReady(element, () => onReady(expectedSrc));
 	}
 
+	/** Loads and decodes a picture off screen, so the stage image that takes it next draws it in the same frame. Never rejects. */
+	function decodedImage(src: string): Promise<void> {
+		const image = new Image();
+		image.src = src;
+		return image.decode().catch(() => undefined);
+	}
+
 	function nextAvatarSrc(img: HTMLImageElement, chain: readonly string[]): string | null {
 		const current = img.currentSrc || img.src;
 		const next =
@@ -549,7 +599,7 @@
 
 	{#if layered || avatarImage}
 		<div class="preview-avatar-stage">
-			<div class="preview-avatar-inner" style:transform={stageTransform}>
+			<div class="preview-avatar-inner" class:holding-look={holdingLook} style:transform={stageTransform}>
 				{#snippet eyesImg()}
 					<!-- LOCAL DEV: the eye-colour layer, over the body/clothes and under the hair; it waits for the picture under it. -->
 					{#key sizedEyesUrl}
@@ -648,7 +698,10 @@
 						alt=""
 						decoding="async"
 						{@attach imageReadyAttachment(sizedAvatarImage, (src) => {
-							if (src === sizedAvatarImage) avatarReady = true;
+							if (src === sizedAvatarImage) {
+								avatarReady = true;
+								avatarDrawnFor = src;
+							}
 						})}
