@@ -0,0 +1,267 @@
+/**
+ * The line-up check for a race outfit's African picture: below the neck it has to sit where the European picture
+ * sits, or the Studio's blend between the two shows ghost edges. The same rules and numbers as the 14 Oct 2026
+ * check (outfit_lineup/build.py `check()`), which was set on 102 older pairs.
+ *
+ * Below the base of the neck only (above it is a different person by design):
+ *   moved      pixels solid in both pictures that are neither the same clothing (every channel within CLOTH_TOL) nor
+ *              skin in both (warm in the European; warm or a near-black shade in the African). The thickest piece,
+ *              in px. Fails above MOVED_LIMIT_PX.
+ *   uncovered  European body the African picture does not cover; wider is the reverse. Reported only: the Studio
+ *              draws every ethnicity on the European outline.
+ */
+import sharp from 'sharp';
+
+import type { RaceOutfitSet } from './raceOutfitPrompts';
+
+const SIZE = 1024;
+/** A little below where the neck meets the shoulders. */
+const CHECK_FROM: Readonly<Record<RaceOutfitSet, number>> = { female: 434, male: 414 };
+const CLOTH_TOL = 40;
+const SHADOW_MAX = 40;
+const SPECK_PX = 200;
+const MIN_PIECE_PX = 40;
+export const LINE_UP_MOVED_LIMIT_PX = 10;
+
+/** A piece's box: left, top, right, bottom (px, inclusive). */
+type Box = readonly [number, number, number, number];
+
+export type PlateLineUp = {
+	readonly movedPx: number;
+	readonly movedAt: Box | null;
+	readonly uncoveredPx: number;
+	readonly uncoveredAt: Box | null;
+	readonly widerPx: number;
+	readonly widerAt: Box | null;
+	readonly pass: boolean;
+};
+
+/** A picture and its cut-out as 1024 x 1024 RGBA pixels. Another size is an error: it is never resized. */
+export async function lineUpPixels(rgb: Buffer, alpha: Buffer): Promise<Buffer> {
+	const [colour, matte] = await Promise.all([
+		sharp(rgb).removeAlpha().toColourspace('srgb').raw().toBuffer({ resolveWithObject: true }),
+		sharp(alpha).greyscale().raw().toBuffer({ resolveWithObject: true })
+	]);
+	for (const { info } of [colour, matte]) {
+		if (info.width !== SIZE || info.height !== SIZE) {
+			throw new Error(`The line-up check needs ${SIZE}x${SIZE} pictures, got ${info.width}x${info.height}.`);
+		}
+	}
+	const out = Buffer.alloc(SIZE * SIZE * 4);
+	for (let i = 0, p = 0; i < SIZE * SIZE; i += 1, p += 4) {
+		out[p] = colour.data[i * 3]!;
+		out[p + 1] = colour.data[i * 3 + 1]!;
+		out[p + 2] = colour.data[i * 3 + 2]!;
+		out[p + 3] = matte.data[i * matte.info.channels]!;
+	}
+	return out;
+}
+
+/** Both pictures as 1024 x 1024 RGBA pixels (`lineUpPixels`). */
+export function checkPlateLineUp(european: Uint8Array, african: Uint8Array, set: RaceOutfitSet): PlateLineUp {
+	const pixels = SIZE * SIZE;
+	if (european.length !== pixels * 4 || african.length !== pixels * 4) {
+		throw new Error(`The line-up check needs ${SIZE}x${SIZE} RGBA pixels.`);
+	}
+	const top = CHECK_FROM[set];
+	const bodyE = figure(european, top);
+	const bodyA = figure(african, top);
+	const moved = new Uint8Array(pixels);
+	const uncovered = new Uint8Array(pixels);
+	const wider = new Uint8Array(pixels);
+	for (let i = top * SIZE, p = i * 4; i < pixels; i += 1, p += 4) {
+		if (bodyE[i] && !bodyA[i]) uncovered[i] = 1;
+		if (bodyA[i] && !bodyE[i]) wider[i] = 1;
+		if (european[p + 3]! < 250 || african[p + 3]! < 250) continue;
+		const cloth =
+			Math.abs(european[p]! - african[p]!) <= CLOTH_TOL &&
+			Math.abs(european[p + 1]! - african[p + 1]!) <= CLOTH_TOL &&
+			Math.abs(european[p + 2]! - african[p + 2]!) <= CLOTH_TOL;
+		if (cloth) continue;
+		const shade = Math.max(african[p]!, african[p + 1]!, african[p + 2]!) <= SHADOW_MAX;
+		if (warm(european, p) && (warm(african, p) || shade)) continue;
+		moved[i] = 1;
+	}
+	const movedPiece = thickest(moved);
+	const uncoveredPiece = thickest(uncovered);
+	const widerPiece = thickest(wider);
+	return {
+		movedPx: movedPiece.px,
+		movedAt: movedPiece.at,
+		uncoveredPx: uncoveredPiece.px,
+		uncoveredAt: uncoveredPiece.at,
+		widerPx: widerPiece.px,
+		widerAt: widerPiece.at,
+		pass: movedPiece.px <= LINE_UP_MOVED_LIMIT_PX
+	};
+}
+
+/** Skin-like: red leads, blue trails. */
+function warm(rgba: Uint8Array, p: number): boolean {
+	const r = rgba[p]!;
+	const g = rgba[p + 1]!;
+	const b = rgba[p + 2]!;
+	return r >= g && g >= b - 4 && r - b > 0.1 * Math.max(r, 1) && r > 20;
+}
+
+/** The body below `top`: specks under SPECK_PX dropped, pinholes under SPECK_PX filled. */
+function figure(rgba: Uint8Array, top: number): Uint8Array {
+	const mask = new Uint8Array(SIZE * SIZE);
+	for (let i = top * SIZE; i < mask.length; i += 1) mask[i] = rgba[i * 4 + 3]! > 127 ? 1 : 0;
+	const pieces = label(mask);
+	if (pieces.sizes.length > 2) {
+		for (let i = 0; i < mask.length; i += 1) {
+			if (mask[i] && pieces.sizes[pieces.labels[i]!]! < SPECK_PX) mask[i] = 0;
+		}
+	}
+	// A hole is background that does not reach the picture's edge.
+	const background = new Uint8Array(mask.length);
+	for (let i = 0; i < mask.length; i += 1) background[i] = mask[i] ? 0 : 1;
+	const gaps = label(background);
+	const open = new Uint8Array(gaps.sizes.length);
+	for (let k = 0; k < SIZE; k += 1) {
+		open[gaps.labels[k]!] = 1;
+		open[gaps.labels[(SIZE - 1) * SIZE + k]!] = 1;
+		open[gaps.labels[k * SIZE]!] = 1;
+		open[gaps.labels[k * SIZE + SIZE - 1]!] = 1;
+	}
+	for (let i = 0; i < mask.length; i += 1) {
+		const gap = gaps.labels[i]!;
+		if (gap && !open[gap] && gaps.sizes[gap]! < SPECK_PX) mask[i] = 1;
+	}
+	return mask;
+}
+
+/** Pieces joined edge to edge (not corner to corner), numbered from 1 in reading order; `sizes[0]` is unused. */
+function label(mask: Uint8Array): { labels: Int32Array; sizes: number[] } {
+	const labels = new Int32Array(mask.length);
+	const sizes = [0];
+	const stack = new Int32Array(mask.length);
+	for (let start = 0; start < mask.length; start += 1) {
+		if (!mask[start] || labels[start]) continue;
+		const id = sizes.length;
+		let size = 0;
+		let n = 0;
+		stack[n++] = start;
+		labels[start] = id;
+		while (n) {
+			const i = stack[--n]!;
+			size += 1;
+			const x = i % SIZE;
+			if (x > 0 && mask[i - 1] && !labels[i - 1]) {
+				labels[i - 1] = id;
+				stack[n++] = i - 1;
+			}
+			if (x < SIZE - 1 && mask[i + 1] && !labels[i + 1]) {
+				labels[i + 1] = id;
+				stack[n++] = i + 1;
+			}
+			if (i >= SIZE && mask[i - SIZE] && !labels[i - SIZE]) {
+				labels[i - SIZE] = id;
+				stack[n++] = i - SIZE;
+			}
+			if (i + SIZE < mask.length && mask[i + SIZE] && !labels[i + SIZE]) {
+				labels[i + SIZE] = id;
+				stack[n++] = i + SIZE;
+			}
+		}
+		sizes.push(size);
+	}
+	return { labels, sizes };
+}
+
+/**
+ * The thickest piece (2 x its deepest inside distance, to 0.1 px) and its box, after dropping 1 px slivers (whatever
+ * no 2 x 2 block fits in) and pieces under MIN_PIECE_PX.
+ */
+function thickest(mask: Uint8Array): { px: number; at: Box | null } {
+	const opened = new Uint8Array(mask.length);
+	for (let y = 0; y < SIZE - 1; y += 1) {
+		for (let x = 0; x < SIZE - 1; x += 1) {
+			const i = y * SIZE + x;
+			if (mask[i] && mask[i + 1] && mask[i + SIZE] && mask[i + SIZE + 1]) {
+				opened[i] = opened[i + 1] = opened[i + SIZE] = opened[i + SIZE + 1] = 1;
+			}
+		}
+	}
+	const pieces = label(opened);
+	if (pieces.sizes.length === 1) return { px: 0, at: null };
+	const inside = squaredDistanceToOutside(opened);
+	const deepest = new Float64Array(pieces.sizes.length);
+	for (let i = 0; i < opened.length; i += 1) {
+		const id = pieces.labels[i]!;
+		if (id && inside[i]! > deepest[id]!) deepest[id] = inside[i]!;
+	}
+	let best = 0;
+	for (let id = 1; id < pieces.sizes.length; id += 1) {
+		if (pieces.sizes[id]! >= MIN_PIECE_PX && (!best || deepest[id]! > deepest[best]!)) best = id;
+	}
+	if (!best) return { px: 0, at: null };
+	let left = SIZE;
+	let topRow = SIZE;
+	let right = -1;
+	let bottom = -1;
+	for (let i = 0; i < opened.length; i += 1) {
+		if (pieces.labels[i] !== best) continue;
+		const x = i % SIZE;
+		const y = (i - x) / SIZE;
+		if (x < left) left = x;
+		if (x > right) right = x;
+		if (y < topRow) topRow = y;
+		if (y > bottom) bottom = y;
+	}
+	return { px: Math.round(2 * Math.sqrt(deepest[best]!) * 10) / 10, at: [left, topRow, right, bottom] };
+}
+
+/** For every pixel of the mask, the squared distance to the nearest pixel outside it (exact; 0 outside). */
+function squaredDistanceToOutside(mask: Uint8Array): Float64Array {
+	const FAR = 1e12;
+	const out = new Float64Array(mask.length);
+	// Down each column: the squared distance to the nearest outside pixel in that column.
+	for (let x = 0; x < SIZE; x += 1) {
+		let d = FAR;
+		for (let y = 0; y < SIZE; y += 1) {
+			d = mask[y * SIZE + x] ? d + 1 : 0;
+			out[y * SIZE + x] = d;
+		}
+		d = FAR;
+		for (let y = SIZE - 1; y >= 0; y -= 1) {
+			d = mask[y * SIZE + x] ? d + 1 : 0;
+			const i = y * SIZE + x;
+			const nearest = Math.min(out[i]!, d);
+			out[i] = nearest >= FAR ? FAR : nearest * nearest;
+		}
+	}
+	// Along each row: the lowest of the parabolas standing on those column distances.
+	const f = new Float64Array(SIZE);
+	const v = new Int32Array(SIZE);
+	const z = new Float64Array(SIZE + 1);
+	for (let y = 0; y < SIZE; y += 1) {
+		const row = y * SIZE;
+		for (let x = 0; x < SIZE; x += 1) f[x] = out[row + x]!;
+		let k = 0;
+		v[0] = 0;
+		z[0] = -Infinity;
+		z[1] = Infinity;
+		for (let q = 1; q < SIZE; q += 1) {
+			let s: number;
+			for (;;) {
+				const p = v[k]!;
+				s = (f[q]! + q * q - (f[p]! + p * p)) / (2 * q - 2 * p);
+				if (s > z[k]!) break;
+				k -= 1;
+			}
+			k += 1;
+			v[k] = q;
+			z[k] = s;
+			z[k + 1] = Infinity;
+		}
+		k = 0;
+		for (let x = 0; x < SIZE; x += 1) {
+			while (z[k + 1]! < x) k += 1;
+			const p = v[k]!;
+			out[row + x] = (x - p) * (x - p) + f[p]!;
+		}
+	}
+	return out;
+}
