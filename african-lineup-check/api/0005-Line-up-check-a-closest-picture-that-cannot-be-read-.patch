-				await closeBilling(prisma, ticket, billing, usage, attempt.modelId);
-				return stepView(ticket, { status: 'ready', jobStatus: 'succeeded', message: 'Ready' });
+				if (kept) {
+					console.error('clothes.lineup kept closest', {
+						invocationId: ticket.invocationId,
+						tryNo: closest.tryNo,
+						movedPx: closest.movedPx,
+						tries: lineUpTries
+					});
+					await finishRaceOutfitEdit(ticket.invocationId, claim.token, kept.rgb, kept.alpha, null);
+					await closeBilling(prisma, ticket, billing, usage, attempt.modelId);
+					return stepView(ticket, { status: 'ready', jobStatus: 'succeeded', message: 'Ready' });
+				}
 			}
 			if (attempt.tryNo > 1 || (attempt.hops ?? 0) > 0) {
 				console.error('clothes.edit failed after re-tries', {
