+		vi.spyOn(console, 'info').mockImplementation(() => {});
+		vi.spyOn(console, 'error').mockImplementation(() => {});
+	});
+	afterEach(() => vi.restoreAllMocks());
+
+	it('is the list the code had when the setting is not set: the four GPT Image models, then Krea 2', () => {
+		expect(clothesImageModels({})).toEqual([
+			AZURE,
+			OPENROUTER,
+			'openrouter/gpt-image-2.5-flare/low/image-to-image',
+			'openai/gpt-image-2.5-sunburst/low/image-to-image',
+			KREA
+		]);
+		expect(clothesImageModels({ [CLOTHES_MODELS_SETTING]: '  ' })).toBe(DEFAULT_CLOTHES_MODELS);
+	});
+
+	it('reads the models in the order the setting lists them, and says once which list is in use', () => {
+		const env = { [CLOTHES_MODELS_SETTING]: ` ${OPENROUTER}, ${AZURE} ,${KREA}` };
+		expect(clothesImageModels(env)).toEqual([OPENROUTER, AZURE, KREA]);
+		expect(clothesImageModels(env)).toEqual([OPENROUTER, AZURE, KREA]);
+		expect(clothesImageModels({ [CLOTHES_MODELS_SETTING]: KREA })).toEqual([KREA]);
+		expect(vi.mocked(console.info).mock.calls.filter(([, said]) => said.models[0] === OPENROUTER)).toEqual([
+			['image models', { job: 'clothes', setting: 'IMAGE_MODELS_CLOTHES', from: 'setting', models: [OPENROUTER, AZURE, KREA] }]
+		]);
+	});
